{
  "name": "portfolio-api",
  "version": "1.0.0",
  "private": true,
  "description": "Azure Functions backend for the portfolio contact form.",
  "main": "dist/functions/*.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prestart": "npm run build",
    "start": "func start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@azure/functions": "^4.16.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
