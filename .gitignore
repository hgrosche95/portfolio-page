# build output
dist/
# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables
.env
.env.production

# generated at build/dev time by scripts/generate-deploy-info.ts and
# scripts/fetch-github-stats.ts — always regenerated via npm pre-scripts
src/data/deploy-info.json
src/data/github-stats.json
src/data/eval-stats.json
# Vitest JSON reports written by the CI test steps, read by the build
.ci/

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# Generated at build time by scripts/generate-og-images.ts
public/og/

# Azure Functions build output
api/node_modules/
api/dist/
api/local.settings.json

# Impeccable: live-server runtime state (critique snapshots are kept)
.impeccable/live/
