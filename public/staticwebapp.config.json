{
  "platform": {
    "apiRuntime": "node:20"
  },
  "responseOverrides": {
    "404": {
      "rewrite": "/404.html",
      "statusCode": 404
    }
  },
  "routes": [
    {
      "route": "/_astro/*",
      "headers": { "cache-control": "public, max-age=31536000, immutable" }
    },
    {
      "route": "/*.html",
      "headers": { "cache-control": "no-cache" }
    },
    {
      "route": "/",
      "headers": { "cache-control": "no-cache" }
    }
  ]
}
