---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import NodeGraph, { type GraphProject } from '../components/NodeGraph';
import ProjectCards, { type CardProject } from '../components/ProjectCards.astro';
import ProjectFilter from '../components/ProjectFilter.astro';
import DeployPipeline from '../components/DeployPipeline';
import Timeline from '../components/Timeline.astro';
import ContactForm from '../components/ContactForm.astro';
import Contact from '../components/Contact.astro';

const projectEntries = (await getCollection('projects')).sort(
	(a, b) => a.data.order - b.data.order,
);

const graphProjects: GraphProject[] = projectEntries.map((entry) => ({
	slug: entry.id,
	label: entry.data.title,
	sublabel: entry.data.techStack.slice(0, 2).join(', '),
	techStack: entry.data.techStack,
	architecture: entry.data.architecture,
}));

const cardProjects: CardProject[] = projectEntries.map((entry) => ({
	slug: entry.id,
	title: entry.data.title,
	summary: entry.data.summary,
	techStack: entry.data.techStack,
	githubRepo: entry.data.githubRepo,
}));

// Derived from the same content the cards/graph already use, not hand-picked:
// a tag only earns a filter chip by actually recurring across projects.
// A one-off tag (a project's only Python dependency, say) would just be a
// filter with one possible result, which isn't a filter, just a relabelled
// link to that project.
const tagCounts = new Map<string, number>();
for (const entry of projectEntries) {
	for (const tag of entry.data.techStack) {
		tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
	}
}
const filterTags = [...tagCounts.entries()]
	.filter(([, count]) => count >= 2)
	.sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))
	.map(([tag]) => tag);
---

<BaseLayout title="Henrik Grosche — Full-Stack-Entwickler">
	<Hero />

	<section id="projects" class="mx-auto max-w-7xl px-4 pb-20">
		<div class="max-w-3xl">
			<SectionHeading
				eyebrow="01 — Projekte"
				title="Private Projekte"
				subtitle="Auf einen Knoten klicken, um zum Projekt zu springen."
				desktopHint="Über den Pfeil klappt die Architektur des Projekts auf."
			/>
			<ProjectFilter tags={filterTags} />
		</div>
		<div
			data-reveal
			class="mt-6"
			data-xray="NodeGraph.tsx · React-Island, client:visible"
			data-xray-kind="island"
		>
			<NodeGraph projects={graphProjects} client:visible />
		</div>

		<ProjectCards projects={cardProjects} />
	</section>

	<section id="ci-cd" class="mx-auto max-w-5xl px-4 pb-20">
		<SectionHeading
			eyebrow="02 — Deployment"
			title="Diese Seite deployt sich selbst"
			subtitle="Echte Daten vom letzten Deployment dieser Seite (Stand: letztes Deployment, kein Live-Ticker)."
			desktopHint="Jeder Push läuft erst durch Tests, jeder Pull Request bekommt automatisch eine eigene Vorschau-Umgebung."
		/>
		<div
			data-reveal
			class="mt-6"
			data-xray="DeployPipeline.tsx · React-Island, client:visible"
			data-xray-kind="island"
		>
			<DeployPipeline client:visible />
		</div>
	</section>

	<section id="erfahrung" class="mx-auto max-w-5xl px-4 pb-20">
		<SectionHeading eyebrow="03 — Werdegang" title="Stationen" />
		<Timeline />
	</section>

	<section id="kontakt" class="mx-auto max-w-5xl px-4 pb-24">
		<SectionHeading
			eyebrow="04 — Kontakt"
			title="Lass uns sprechen"
			subtitle="Offen für Anfragen — am schnellsten per E-Mail."
		/>
		<ContactForm />
		<Contact />
	</section>
</BaseLayout>
