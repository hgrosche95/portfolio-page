---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ProjectIndex from '../components/ProjectIndex.astro';
import DemoReel from '../components/DemoReel.astro';
import ProjectFilter from '../components/ProjectFilter.astro';
import Skills from '../components/Skills.astro';
import { kindLabels, type ProjectKind } from '../lib/project-kinds';
import DeployPipeline from '../components/DeployPipeline';
import Timeline from '../components/Timeline.astro';
import ContactForm from '../components/ContactForm.astro';
import Contact from '../components/Contact.astro';
import TraceSection from '../components/TraceSection.astro';

const projectEntries = (await getCollection('projects')).sort(
	(a, b) => a.data.order - b.data.order,
);

// Filter chips are derived from the content, most common kind first, so a
// new project needs no change here.
const kindCounts = new Map<ProjectKind, number>();
for (const entry of projectEntries) {
	kindCounts.set(entry.data.kind, (kindCounts.get(entry.data.kind) ?? 0) + 1);
}
const filterKinds = [...kindCounts.entries()]
	.sort((a, b) => b[1] - a[1] || kindLabels[a[0]].localeCompare(kindLabels[b[0]]))
	.map(([kind, count]) => ({ kind, count }));
---

<BaseLayout title="Henrik Grosche · Full-Stack-Entwickler" marginTrace={false}>
	{/* One trace from the hero down to the contact form, see TraceSection. */}
	<TraceSection variant="start" nodeY="calc(var(--hero-top) + 2.25rem + var(--text-hero) * 0.45)">
		<Hero />
	</TraceSection>

	<TraceSection id="projects">
		<SectionHeading
			id="projects-title"
			title="Projekte"
			subtitle="Private Projekte. Jede Zeile klappt auf, mit Schaltplan, wichtigster Entscheidung und Links."
		/>
		<ProjectFilter kinds={filterKinds} total={projectEntries.length} />
		<ProjectIndex projects={projectEntries} />
	</TraceSection>

	<TraceSection id="demos">
		<SectionHeading
			id="demos-title"
			title="Aus den Live-Demos"
			subtitle="Bildschirmaufnahmen echter Läufe, gekürzt, beschleunigt und ohne Ton. Jede App lässt sich selbst ausprobieren."
			desktopHint="Die Punkte unter dem Video springen zu einzelnen Stellen."
		/>
		<DemoReel projects={projectEntries} />
	</TraceSection>

	<TraceSection id="ci-cd">
		<SectionHeading
			id="ci-cd-title"
			title="Diese Seite deployt sich selbst"
			subtitle="Echte Daten vom letzten Deployment dieser Seite (Stand: letztes Deployment, kein Live-Ticker)."
			desktopHint="Jeder Push läuft erst durch Tests, jeder Pull Request bekommt automatisch eine eigene Vorschau-Umgebung."
		/>
		<div data-reveal class="mt-6">
			<DeployPipeline client:visible />
		</div>
	</TraceSection>

	<TraceSection id="erfahrung">
		<SectionHeading id="erfahrung-title" title="Stationen" />
		<Timeline />
		<Skills />
	</TraceSection>

	<TraceSection id="kontakt" variant="end">
		<SectionHeading
			id="kontakt-title"
			title="Lass uns sprechen"
			subtitle="Offen für Anfragen, am schnellsten per E-Mail."
		/>
		<ContactForm />
		<Contact />
	</TraceSection>
</BaseLayout>
