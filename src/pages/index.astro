---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import NodeGraph, { type GraphProject } from '../components/NodeGraph';
import DeployPipeline from '../components/DeployPipeline';

const projectEntries = await getCollection('projects');
const graphProjects: GraphProject[] = projectEntries
	.sort((a, b) => a.data.order - b.data.order)
	.map((entry) => ({
		slug: entry.id,
		label: entry.data.title,
		sublabel: entry.data.techStack.join(', '),
	}));
---

<BaseLayout title="Henrik Grosche — Full-Stack-Entwickler">
	<section class="mx-auto max-w-5xl px-4 py-16">
		<h1 class="font-mono text-2xl text-[var(--color-text)]">Henrik Grosche</h1>
		<p class="mt-2 font-mono text-sm text-[var(--color-text-muted)]">
			Full-Stack-Entwickler — Inhalte folgen in den nächsten Phasen.
		</p>
	</section>
	<section id="projects" class="mx-auto max-w-5xl px-4 pb-16">
		<h2 class="font-mono text-lg text-[var(--color-text)]">Wie ich Systeme verbinde</h2>
		<p class="mt-1 font-mono text-xs text-[var(--color-text-muted)]">
			Auf einen Knoten klicken, um zum Projekt zu springen.
		</p>
		<div class="mt-4">
			<NodeGraph projects={graphProjects} client:visible />
		</div>
	</section>
	<section id="ci-cd" class="mx-auto max-w-5xl px-4 pb-16">
		<h2 class="font-mono text-lg text-[var(--color-text)]">Diese Seite deployt sich selbst</h2>
		<p class="mt-1 font-mono text-xs text-[var(--color-text-muted)]">
			Echte Daten vom letzten Deployment dieser Seite (Stand: letztes Deployment, kein Live-Ticker).
		</p>
		<div class="mt-4">
			<DeployPipeline client:visible />
		</div>
	</section>
</BaseLayout>
