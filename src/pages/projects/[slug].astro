---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import githubStats from '../../data/github-stats.json';

export async function getStaticPaths() {
	const projectEntries = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
	return projectEntries.map((entry, index) => ({
		params: { slug: entry.id },
		props: {
			entry,
			// Wrap around, so every project page offers a way onward.
			next: projectEntries[(index + 1) % projectEntries.length],
		},
	}));
}

const { entry, next } = Astro.props;
const { Content } = await render(entry);
// Possibly absent: fetch-github-stats.ts omits repos the GitHub API did not
// answer for rather than failing the build over it.
const stats = (
	githubStats as Record<
		string,
		{ stars: number; language: string | null; lastPushedAt: string; description: string | null } | undefined
	>
)[entry.data.githubRepo];
const lastPushed = stats
	? new Date(stats.lastPushedAt).toLocaleDateString('de-DE', { dateStyle: 'medium' })
	: null;
---

<BaseLayout
	title={`${entry.data.title} — Henrik Grosche`}
	description={entry.data.summary}
	image={`/og/${entry.id}.png`}
>
	<article class="mx-auto max-w-3xl px-4 pt-12 pb-20">
		<a
			href="/#projects"
			class="font-mono text-xs text-[var(--color-text-muted)] transition-colors hover:text-[var(--color-accent)]"
		>
			&larr; zurück zur Übersicht
		</a>

		<h1 class="mt-4 text-3xl font-semibold tracking-tight text-[var(--color-text)] sm:text-4xl">
			{entry.data.title}
		</h1>

		<div class="mt-4 flex flex-wrap gap-1.5">
			{
				entry.data.techStack.map((tech: string) => (
					<span class="rounded border border-[var(--color-border)] px-2 py-0.5 font-mono text-xs text-[var(--color-text-muted)]">
						{tech}
					</span>
				))
			}
		</div>

		{
			entry.data.liveUrl && (
				<a
					href={entry.data.liveUrl}
					target="_blank"
					rel="noopener noreferrer"
					class="mt-5 inline-flex items-center gap-2 rounded-md bg-[var(--color-accent)] px-4 py-2 font-mono text-sm font-medium text-[var(--color-bg)] transition-opacity hover:opacity-85"
				>
					{entry.data.liveLabel ?? 'Live ansehen'}
					<span aria-hidden="true">&#8599;</span>
					<span class="sr-only">(öffnet in neuem Tab)</span>
				</a>
			)
		}

		<div
			class="mt-5 flex flex-wrap items-center gap-x-5 gap-y-2 border-y border-[var(--color-border)] py-3 font-mono text-xs text-[var(--color-text-muted)]"
		>
			{stats && <span>&#9733; {stats.stars}</span>}
			{stats?.language && <span>{stats.language}</span>}
			{lastPushed && <span>zuletzt aktualisiert: {lastPushed} (Stand: letztes Deployment)</span>}
			<a
				href={`https://github.com/hgrosche95/${entry.data.githubRepo}`}
				target="_blank"
				rel="noopener noreferrer"
				class="ml-auto text-[var(--color-accent)] hover:underline"
			>
				auf GitHub ansehen &rarr;
			</a>
		</div>

		<div class="project-content mt-8 max-w-none space-y-5 text-base leading-relaxed text-[var(--color-text-muted)]">
			<Content />
		</div>

		<div
			id="lightbox"
			class="fixed inset-0 z-50 hidden items-center justify-center bg-black/80 p-6"
			role="dialog"
			aria-modal="true"
			aria-label="Screenshot vergrößert"
		>
			<button
				id="lightbox-close"
				type="button"
				aria-label="Schließen"
				class="absolute top-4 right-4 grid size-10 place-items-center rounded-md border border-white/20 text-2xl leading-none text-white transition-colors hover:border-white/50"
			>
				&times;
			</button>
			<img id="lightbox-img" src="" alt="" class="max-h-[90vh] max-w-[90vw] rounded-lg object-contain" />
		</div>

		<a
			href={`/projects/${next.id}`}
			class="group mt-14 flex items-center justify-between gap-4 rounded-lg border border-[var(--color-border)] bg-[var(--color-surface)] p-4 transition-colors hover:border-[var(--color-accent)]"
		>
			<span>
				<span class="font-mono text-xs tracking-wider text-[var(--color-text-muted)] uppercase">
					Nächstes Projekt
				</span>
				<span
					class="mt-1 block font-medium text-[var(--color-text)] transition-colors group-hover:text-[var(--color-accent)]"
				>
					{next.data.title}
				</span>
			</span>
			<span
				class="font-mono text-[var(--color-text-muted)] transition-transform group-hover:translate-x-1 group-hover:text-[var(--color-accent)]"
				aria-hidden="true">&rarr;</span
			>
		</a>

		<script is:inline>
			(function () {
				const lightbox = document.getElementById('lightbox');
				const lightboxImg = document.getElementById('lightbox-img');
				const closeBtn = document.getElementById('lightbox-close');
				const thumbs = document.querySelectorAll('.project-content img');

				function open(img) {
					lightboxImg.src = img.src;
					lightboxImg.alt = img.alt;
					lightbox.classList.remove('hidden');
					lightbox.classList.add('flex');
					document.body.style.overflow = 'hidden';
					closeBtn.focus();
				}

				function close() {
					lightbox.classList.add('hidden');
					lightbox.classList.remove('flex');
					document.body.style.overflow = '';
					lightboxImg.src = '';
				}

				thumbs.forEach(function (img) {
					img.classList.add('cursor-zoom-in');
					img.tabIndex = 0;
					img.setAttribute('role', 'button');
					img.setAttribute('aria-label', 'Screenshot vergrößern: ' + img.alt);
					img.addEventListener('click', function () {
						open(img);
					});
					img.addEventListener('keydown', function (event) {
						if (event.key === 'Enter' || event.key === ' ') {
							event.preventDefault();
							open(img);
						}
					});
				});

				closeBtn.addEventListener('click', close);
				lightbox.addEventListener('click', function (event) {
					if (event.target === lightbox) close();
				});
				document.addEventListener('keydown', function (event) {
					if (event.key === 'Escape' && !lightbox.classList.contains('hidden')) close();
				});
			})();
		</script>
	</article>
</BaseLayout>
