---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Schematic from '../../components/Schematic.astro';
import DecisionNotes from '../../components/DecisionNotes.astro';
import githubStats from '../../data/github-stats.json';

export async function getStaticPaths() {
	const projectEntries = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
	return projectEntries.map((entry, index) => ({
		params: { slug: entry.id },
		props: {
			entry,
			// Wrap around, so every project page offers a way onward.
			next: projectEntries[(index + 1) % projectEntries.length],
		},
	}));
}

const { entry, next } = Astro.props;
const { Content } = await render(entry);
// Possibly absent: fetch-github-stats.ts omits repos the GitHub API did not
// answer for rather than failing the build over it.
const stats = (
	githubStats as Record<
		string,
		{ stars: number; language: string | null; lastPushedAt: string; description: string | null } | undefined
	>
)[entry.data.githubRepo];
const lastPushed = stats
	? new Date(stats.lastPushedAt).toLocaleDateString('de-DE', { dateStyle: 'medium' })
	: null;
const repoUrl = `https://github.com/hgrosche95/${entry.data.githubRepo}`;
const architecture = entry.data.architecture;

const kindLabels = {
	fullstack: 'Full-Stack',
	agent: 'KI-Agent',
	orchestration: 'Orchestrierung',
	static: 'Statische Seite',
} as const;

// Rows without data are dropped rather than shown as "–". Stars are left
// out on purpose: on repos this young they would only ever read "0".
const sheet = [
	['Art', kindLabels[entry.data.kind]],
	['Sprache', stats?.language],
	['Aufbau', architecture && `${architecture.nodes.length} Komponenten · ${architecture.edges.length} Verbindungen`],
	['Betrieb', entry.data.hosting],
	['Stand', lastPushed && `${lastPushed} (letztes Deployment)`],
].filter((row): row is [string, string] => Boolean(row[1]));
---

<BaseLayout
	title={`${entry.data.title} — Henrik Grosche`}
	description={entry.data.summary}
	image={`/og/${entry.id}.png`}
>
	<!-- Same width as the header, wide enough for the schematic; running text
	     below keeps its own reading width. -->
	<article class="mx-auto max-w-5xl px-4 pt-12 pb-20">
		<a
			href="/#projects"
			class="font-mono text-xs text-[var(--color-text-muted)] transition-colors hover:text-[var(--color-accent)]"
		>
			&larr; zurück zur Übersicht
		</a>

		<header class="mt-6 grid gap-8 lg:grid-cols-[minmax(0,1fr)_300px] lg:items-start">
			<div>
				<p class="font-mono text-xs tracking-widest text-[var(--color-accent)] uppercase">{kindLabels[entry.data.kind]}</p>
				<h1 class="mt-3 text-4xl font-semibold tracking-tight text-[var(--color-text)] sm:text-5xl">
					{entry.data.title}
				</h1>
				<p class="mt-4 max-w-2xl text-lg leading-relaxed text-[var(--color-text)]">{entry.data.summary}</p>

				<div class="mt-5 flex flex-wrap items-center gap-1.5">
					{
						entry.data.techStack.map((tech: string) => (
							<span class="rounded border border-[var(--color-border)] px-2 py-0.5 font-mono text-xs text-[var(--color-text-muted)]">
								{tech}
							</span>
						))
					}
					{
						entry.data.plannedTech && entry.data.plannedTech.length > 0 && (
							<>
								<span class="ml-1.5 font-mono text-xs text-[var(--color-text-muted)]">geplant:</span>
								{entry.data.plannedTech.map((tech: string) => (
									<span class="rounded border border-dashed border-[var(--color-border-strong)] px-2 py-0.5 font-mono text-xs text-[var(--color-text-muted)]">
										{tech}
									</span>
								))}
							</>
						)
					}
				</div>

				<div class="mt-6 flex flex-wrap items-center gap-3">
					{
						entry.data.liveUrl && (
							<a
								href={entry.data.liveUrl}
								target="_blank"
								rel="noopener noreferrer"
								class="inline-flex items-center gap-2 rounded-md bg-[var(--color-accent)] px-4 py-2 font-mono text-sm font-medium text-[var(--color-bg)] transition-opacity hover:opacity-85"
							>
								{entry.data.liveLabel ?? 'Live ansehen'}
								<span aria-hidden="true">&#8599;</span>
								<span class="sr-only">(öffnet in neuem Tab)</span>
							</a>
						)
					}
					<a
						href={repoUrl}
						target="_blank"
						rel="noopener noreferrer"
						class="inline-flex items-center gap-2 rounded-md border border-[var(--color-border-strong)] px-4 py-2 font-mono text-sm text-[var(--color-text)] transition-colors hover:border-[var(--color-accent)] hover:text-[var(--color-accent)]"
					>
						Code auf GitHub
						<span aria-hidden="true">&#8599;</span>
						<span class="sr-only">(öffnet in neuem Tab)</span>
					</a>
				</div>

				{
					entry.data.liveUrl && entry.data.liveStatusCheck && (
						<p
							id="live-status"
							data-project={entry.id}
							class="mt-2 font-mono text-xs text-[var(--color-text-muted)]"
							data-xray="Live-Status · Inline-Skript, ruft /api/live-status"
							data-xray-kind="static"
						>
							Prüfe, ob der Server gerade wach ist…
						</p>
					)
				}
			</div>

			{/* A data sheet, like on a component: the facts a reviewer scans for first. */}
			<dl class="grid grid-cols-[auto_minmax(0,1fr)] border-t border-[var(--color-text)] text-sm">
				{
					sheet.map(([term, value]) => (
						<>
							<dt class="border-b border-[var(--color-border)] py-2.5 pr-5 font-mono text-[11px] tracking-wider text-[var(--color-text-muted)] uppercase">
								{term}
							</dt>
							<dd class="border-b border-[var(--color-border)] py-2 text-[var(--color-text)] tabular-nums">{value}</dd>
						</>
					))
				}
				<dt class="border-b border-[var(--color-border)] py-2.5 pr-5 font-mono text-[11px] tracking-wider text-[var(--color-text-muted)] uppercase">
					Repo
				</dt>
				<dd class="border-b border-[var(--color-border)] py-2">
					<a href={repoUrl} target="_blank" rel="noopener noreferrer" class="break-all text-[var(--color-accent)] hover:underline">
						hgrosche95/{entry.data.githubRepo}
					</a>
				</dd>
			</dl>
		</header>

		{
			entry.data.architecture?.lanes && (
				<section class="mt-14" aria-labelledby="schematic-title">
					<h2
						id="schematic-title"
						class="relative mb-4 flex items-center gap-3 text-xl font-semibold tracking-tight text-[var(--color-text)]"
						data-trace-stop
					>
						<span class="trace-branch" aria-hidden="true"></span>
						<span class="solder-pad" aria-hidden="true"></span>
						So hängt es zusammen
					</h2>
					<Schematic architecture={entry.data.architecture} />
				</section>
			)
		}

		<div class="mt-14 grid gap-10 lg:grid-cols-[minmax(0,1fr)_280px]">
			{/* First in the source so a phone shows the short version before
			    the long write-up; moved beside it once there is room. */}
			{
				entry.data.decisions && (
					<div class="lg:order-last">
						<div class="lg:sticky lg:top-24">
							<DecisionNotes decisions={entry.data.decisions} />
						</div>
					</div>
				)
			}
			<div class="project-content max-w-3xl space-y-5 text-base leading-relaxed text-[var(--color-text-muted)]">
				<Content />
			</div>
		</div>

		<div
			id="lightbox"
			class="fixed inset-0 z-50 hidden items-center justify-center bg-black/80 p-6"
			role="dialog"
			aria-modal="true"
			aria-label="Screenshot vergrößert"
		>
			<button
				id="lightbox-close"
				type="button"
				aria-label="Schließen"
				class="absolute top-4 right-4 grid size-10 place-items-center rounded-md border border-white/20 text-2xl leading-none text-white transition-colors hover:border-white/50"
			>
				&times;
			</button>
			<img id="lightbox-img" src="" alt="" class="max-h-[90vh] max-w-[90vw] rounded-lg object-contain" />
		</div>

		<a
			href={`/projects/${next.id}`}
			class="group mt-14 flex items-center justify-between gap-4 rounded-lg border border-[var(--color-border)] bg-[var(--color-surface)] p-4 transition-colors hover:border-[var(--color-accent)]"
		>
			<span>
				<span class="font-mono text-xs tracking-wider text-[var(--color-text-muted)] uppercase">
					Nächstes Projekt
				</span>
				<span
					class="mt-1 block font-medium text-[var(--color-text)] transition-colors group-hover:text-[var(--color-accent)]"
				>
					{next.data.title}
				</span>
			</span>
			<span
				class="font-mono text-[var(--color-text-muted)] transition-transform group-hover:translate-x-1 group-hover:text-[var(--color-accent)]"
				aria-hidden="true">&rarr;</span
			>
		</a>

		<script is:inline>
			(function () {
				const lightbox = document.getElementById('lightbox');
				const lightboxImg = document.getElementById('lightbox-img');
				const closeBtn = document.getElementById('lightbox-close');
				const thumbs = document.querySelectorAll('.project-content img');

				function open(img) {
					lightboxImg.src = img.src;
					lightboxImg.alt = img.alt;
					lightbox.classList.remove('hidden');
					lightbox.classList.add('flex');
					document.body.style.overflow = 'hidden';
					closeBtn.focus();
				}

				function close() {
					lightbox.classList.add('hidden');
					lightbox.classList.remove('flex');
					document.body.style.overflow = '';
					lightboxImg.src = '';
				}

				thumbs.forEach(function (img) {
					img.classList.add('cursor-zoom-in');
					img.tabIndex = 0;
					img.setAttribute('role', 'button');
					img.setAttribute('aria-label', 'Screenshot vergrößern: ' + img.alt);
					img.addEventListener('click', function () {
						open(img);
					});
					img.addEventListener('keydown', function (event) {
						if (event.key === 'Enter' || event.key === ' ') {
							event.preventDefault();
							open(img);
						}
					});
				});

				closeBtn.addEventListener('click', close);
				lightbox.addEventListener('click', function (event) {
					if (event.target === lightbox) close();
				});
				document.addEventListener('keydown', function (event) {
					if (event.key === 'Escape' && !lightbox.classList.contains('hidden')) close();
				});
			})();
		</script>

		<script is:inline>
			(function () {
				const el = document.getElementById('live-status');
				if (!el) return;

				const project = el.dataset.project;

				fetch('/api/live-status?project=' + encodeURIComponent(project))
					.then(function (response) {
						if (!response.ok) throw new Error('live-status request failed');
						return response.json();
					})
					.then(function (data) {
						if (data.awake) {
							el.textContent = '● Server ist gerade wach';
							el.classList.add('text-[var(--color-live)]');
						} else {
							el.textContent = '○ Server schläft gerade, wacht beim Öffnen in ca. 30–40s auf';
						}
					})
					.catch(function () {
						// No status is better than a wrong one: this is a "nice to
						// know", not something worth showing an error state for.
						el.hidden = true;
					});
			})();
		</script>
	</article>
</BaseLayout>
