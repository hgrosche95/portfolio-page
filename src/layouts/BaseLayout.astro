---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
	title: string;
	description?: string;
	/** Relative path to the social-preview image; resolved to an absolute URL. */
	image?: string;
}

const {
	title,
	description = 'Full-Stack-Entwickler Portfolio von Henrik Grosche — mit Node-Graph-Navigation, echten CI/CD-Daten und Projekten, die tatsächlich erklärt werden.',
	// Generated at build time by scripts/generate-og-images.ts. The portrait is
	// deliberately not used here: it is 800x1067 portrait, which social cards
	// crop to a ~1.91:1 landscape strip.
	image = '/og/default.png',
} = Astro.props;

const absoluteImageUrl = new URL(image, Astro.site ?? Astro.url).toString();
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url).toString();
---

<!doctype html>
<html lang="de">
	<head>
		<script is:inline>
			(function () {
				const stored = localStorage.getItem('theme');
				const isDark = stored ? stored === 'dark' : true;
				document.documentElement.classList.toggle('dark', isDark);
			})();
		</script>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<link rel="canonical" href={canonicalUrl} />
		<title>{title}</title>

		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={absoluteImageUrl} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:locale" content="de_DE" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={absoluteImageUrl} />
	</head>
	<body class="flex min-h-screen flex-col bg-[var(--color-bg)] text-[var(--color-text)]">
		<Header />
		<main class="flex-1">
			<slot />
		</main>
		<Footer />

		{/* Desktop only: the labels would cover the content on a phone. */}
		<div class="fixed right-4 bottom-4 z-50 hidden flex-col items-end gap-2 sm:flex">
			<div
				id="xray-legend"
				hidden
				class="max-w-xs rounded-lg border border-[var(--color-border)] bg-[var(--color-surface)] p-3 text-xs leading-relaxed text-[var(--color-text-muted)] shadow-lg"
			>
				<p>
					<span class="font-mono text-[var(--color-accent)]">durchgezogen</span> = React-Island, lädt
					JavaScript
				</p>
				<p class="mt-1">
					<span class="font-mono">gestrichelt</span> = statisches HTML aus dem Astro-Build, kein
					JS-Bundle
				</p>
				<p class="mt-2">
					Diese Seite lädt React nur für die zwei markierten Elemente und die erst beim
					Hineinscrollen (<span class="font-mono">client:visible</span>)
				</p>
			</div>
			<button
				id="xray-toggle"
				type="button"
				aria-pressed="false"
				class="flex items-center gap-2 rounded-md border border-[var(--color-border)] bg-[var(--color-surface)] px-3 py-2 font-mono text-xs text-[var(--color-text-muted)] shadow-lg transition-colors hover:border-[var(--color-accent)] hover:text-[var(--color-accent)] aria-pressed:border-[var(--color-accent)] aria-pressed:text-[var(--color-accent)]"
			>
				<svg
					class="size-4"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
					aria-hidden="true"
				>
					<rect x="3" y="3" width="18" height="18" rx="2"></rect>
					<path d="M3 9h18M9 9v12"></path>
				</svg>
				Röntgenblick
			</button>
		</div>

		<script is:inline>
			(function () {
				const button = document.getElementById('xray-toggle');
				const legend = document.getElementById('xray-legend');
				if (!button) return;

				button.addEventListener('click', function () {
					const active = document.documentElement.classList.toggle('xray');
					button.setAttribute('aria-pressed', String(active));
					legend.hidden = !active;
				});
			})();
		</script>

		<script is:inline>
			(function () {
				const targets = Array.prototype.slice.call(document.querySelectorAll('[data-reveal]'));
				if (!targets.length) return;
				if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

				// Opt in to the hiding CSS only now that the revealing code below is
				// guaranteed to run. A plain scroll check is used instead of
				// IntersectionObserver because it cannot silently no-op: if it ever
				// failed, content would stay invisible.
				document.documentElement.classList.add('js-reveal');

				let pending = targets;
				let queued = false;

				function reveal() {
					queued = false;
					const limit = window.innerHeight * 0.9;
					pending = pending.filter(function (el) {
						if (el.getBoundingClientRect().top > limit) return true;
						el.setAttribute('data-revealed', '');
						return false;
					});
					if (!pending.length) {
						window.removeEventListener('scroll', schedule);
						window.removeEventListener('resize', schedule);
					}
				}

				function schedule() {
					if (queued) return;
					queued = true;
					window.requestAnimationFrame(reveal);
				}

				window.addEventListener('scroll', schedule, { passive: true });
				window.addEventListener('resize', schedule);
				reveal();
			})();
		</script>
	</body>
</html>
