---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
	title: string;
	description?: string;
	/** Relative path to the social-preview image; resolved to an absolute URL. */
	image?: string;
}

const {
	title,
	description = 'Full-Stack-Entwickler Portfolio von Henrik Grosche — mit Node-Graph-Navigation, echten CI/CD-Daten und Projekten, die tatsächlich erklärt werden.',
	image = '/profile.webp',
} = Astro.props;

const absoluteImageUrl = new URL(image, Astro.site ?? Astro.url).toString();
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url).toString();
---

<!doctype html>
<html lang="de">
	<head>
		<script is:inline>
			(function () {
				const stored = localStorage.getItem('theme');
				const isDark = stored ? stored === 'dark' : true;
				document.documentElement.classList.toggle('dark', isDark);
			})();
		</script>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<link rel="canonical" href={canonicalUrl} />
		<title>{title}</title>

		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={absoluteImageUrl} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:locale" content="de_DE" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={absoluteImageUrl} />
	</head>
	<body class="flex min-h-screen flex-col bg-[var(--color-bg)] text-[var(--color-text)]">
		<Header />
		<main class="flex-1">
			<slot />
		</main>
		<Footer />
		<script is:inline>
			(function () {
				const targets = Array.prototype.slice.call(document.querySelectorAll('[data-reveal]'));
				if (!targets.length) return;
				if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

				// Opt in to the hiding CSS only now that the revealing code below is
				// guaranteed to run. A plain scroll check is used instead of
				// IntersectionObserver because it cannot silently no-op: if it ever
				// failed, content would stay invisible.
				document.documentElement.classList.add('js-reveal');

				let pending = targets;
				let queued = false;

				function reveal() {
					queued = false;
					const limit = window.innerHeight * 0.9;
					pending = pending.filter(function (el) {
						if (el.getBoundingClientRect().top > limit) return true;
						el.setAttribute('data-revealed', '');
						return false;
					});
					if (!pending.length) {
						window.removeEventListener('scroll', schedule);
						window.removeEventListener('resize', schedule);
					}
				}

				function schedule() {
					if (queued) return;
					queued = true;
					window.requestAnimationFrame(reveal);
				}

				window.addEventListener('scroll', schedule, { passive: true });
				window.addEventListener('resize', schedule);
				reveal();
			})();
		</script>
	</body>
</html>
