---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
	title: string;
	description?: string;
	/** Relative path to the social-preview image; resolved to an absolute URL. */
	image?: string;
}

const {
	title,
	description = 'Full-Stack-Entwickler Portfolio von Henrik Grosche — mit interaktiven Architektur-Schaltplänen, echten CI/CD-Daten und Projekten, die tatsächlich erklärt werden.',
	// Generated at build time by scripts/generate-og-images.ts. The portrait is
	// deliberately not used here: it is 800x1067 portrait, which social cards
	// crop to a ~1.91:1 landscape strip.
	image = '/og/default.png',
} = Astro.props;

const absoluteImageUrl = new URL(image, Astro.site ?? Astro.url).toString();
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url).toString();
---

<!doctype html>
<html lang="de">
	<head>
		<script is:inline>
			(function () {
				const stored = localStorage.getItem('theme');
				const isDark = stored ? stored === 'dark' : true;
				document.documentElement.classList.toggle('dark', isDark);
			})();
		</script>
		<script is:inline>
			// Switch the scroll-reveal hiding on before the first paint, so content
			// near the fold is not drawn once and then hidden again. The reveal
			// script at the end of <body> confirms it took over; if it never does,
			// this timeout shows everything again, so nothing can stay invisible.
			(function () {
				if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
				const root = document.documentElement;
				root.classList.add('js-reveal');
				setTimeout(function () {
					if (!window.__revealReady) root.classList.remove('js-reveal');
				}, 3000);
			})();
		</script>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<link rel="canonical" href={canonicalUrl} />
		<title>{title}</title>

		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={absoluteImageUrl} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:locale" content="de_DE" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={absoluteImageUrl} />
	</head>
	<body class="flex min-h-screen flex-col bg-[var(--color-bg)] text-[var(--color-text)]">
		<Header />
		<main class="relative flex-1">
			<div class="trace" id="trace" aria-hidden="true"></div>
			<slot />
		</main>
		<Footer />

		<script is:inline>
			(function () {
				// The copper part of the margin trace reaches down to a fixed
				// reading line in the viewport; a heading counts as reached once
				// it has passed that line. Purely cosmetic: without this script
				// the trace and its branches simply stay grey.
				const trace = document.getElementById('trace');
				if (!trace) return;
				const main = trace.parentElement;
				const stops = Array.prototype.slice.call(document.querySelectorAll('[data-trace-stop]'));
				const READING_LINE = 0.55;
				let queued = false;
				function update() {
					queued = false;
					const line = window.innerHeight * READING_LINE;
					const box = main.getBoundingClientRect();
					// At the very bottom the last headings may never cross the
					// line, so the end of the page counts as fully read.
					const atEnd = window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2;
					const progress = atEnd ? 1 : (line - box.top) / box.height;
					trace.style.setProperty('--trace-progress', Math.max(0.02, Math.min(1, progress)).toFixed(4));
					stops.forEach(function (stop) {
						const rect = stop.getBoundingClientRect();
						stop.classList.toggle('reached', atEnd || rect.top + rect.height / 2 <= line);
					});
				}
				function schedule() {
					if (queued) return;
					queued = true;
					window.requestAnimationFrame(update);
				}
				window.addEventListener('scroll', schedule, { passive: true });
				window.addEventListener('resize', schedule);
				update();
			})();
		</script>

		{/* Desktop only: the labels would cover the content on a phone. */}
		<div class="fixed right-4 bottom-4 z-50 hidden flex-col items-end gap-2 sm:flex">
			<div
				id="xray-legend"
				hidden
				class="max-w-xs rounded-lg border border-[var(--color-border)] bg-[var(--color-surface)] p-3 text-xs leading-relaxed text-[var(--color-text-muted)] shadow-lg"
			>
				<p>
					<span class="font-mono text-[var(--color-accent)]">durchgezogen</span> = React-Island, lädt
					JavaScript
				</p>
				<p class="mt-1">
					<span class="font-mono">gestrichelt</span> = statisches HTML aus dem Astro-Build, kein
					JS-Bundle
				</p>
				<p class="mt-2">
					Diese Seite lädt React nur für die Deploy-Pipeline, und die erst beim Hineinscrollen
					(<span class="font-mono">client:visible</span>). Die Schaltpläne sind statisches SVG
					mit ein paar Zeilen Inline-Skript.
				</p>
			</div>
			<button
				id="xray-toggle"
				type="button"
				aria-pressed="false"
				class="flex items-center gap-2 rounded-md border border-[var(--color-border)] bg-[var(--color-surface)] px-3 py-2 font-mono text-xs text-[var(--color-text-muted)] shadow-lg transition-colors hover:border-[var(--color-accent)] hover:text-[var(--color-accent)] aria-pressed:border-[var(--color-accent)] aria-pressed:text-[var(--color-accent)]"
			>
				<svg
					class="size-4"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
					aria-hidden="true"
				>
					<rect x="3" y="3" width="18" height="18" rx="2"></rect>
					<path d="M3 9h18M9 9v12"></path>
				</svg>
				Röntgenblick
			</button>
		</div>

		<script is:inline>
			(function () {
				const button = document.getElementById('xray-toggle');
				const legend = document.getElementById('xray-legend');
				if (!button) return;

				button.addEventListener('click', function () {
					const active = document.documentElement.classList.toggle('xray');
					button.setAttribute('aria-pressed', String(active));
					legend.hidden = !active;
				});
			})();
		</script>

		<script is:inline>
			(function () {
				const targets = Array.prototype.slice.call(document.querySelectorAll('[data-reveal]'));
				if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
				if (!targets.length) {
					// Nothing to reveal on this page: undo the early opt-in from <head>.
					document.documentElement.classList.remove('js-reveal');
					return;
				}

				// The hiding CSS was switched on in <head>; confirm that the revealing
				// code below is running, which disarms the fallback there. A plain
				// scroll check is used instead of IntersectionObserver because it
				// cannot silently no-op: if it ever failed, content would stay invisible.
				window.__revealReady = true;
				document.documentElement.classList.add('js-reveal');

				let pending = targets;
				let queued = false;
				// While the homepage hero plays its boot sequence, hold everything
				// else back so it follows the hero instead of competing with it. The
				// hero always ends its boot state (it has its own timeout), and this
				// has one too, so nothing can stay hidden.
				let held = document.documentElement.hasAttribute('data-hero-booting');
				function release() {
					if (!held) return;
					held = false;
					schedule();
				}
				if (held) {
					document.addEventListener('hero:booted', function () {
						setTimeout(release, 200);
					}, { once: true });
					setTimeout(release, 8000);
				}

				const STAGGER = 90;
				const MAX_DELAY = 540;

				function reveal() {
					queued = false;
					if (held) return;
					const limit = window.innerHeight * 0.9;
					// Elements that come into view together fade in one after another.
					let batch = 0;
					pending = pending.filter(function (el) {
						if (el.getBoundingClientRect().top > limit) return true;
						el.style.transitionDelay = Math.min(batch * STAGGER, MAX_DELAY) + 'ms';
						batch += 1;
						el.setAttribute('data-revealed', '');
						// The delay is only for this entrance; drop it so it never
						// slows down any later transition on the same element.
						el.addEventListener('transitionend', function () {
							el.style.transitionDelay = '';
						}, { once: true });
						return false;
					});
					if (!pending.length) {
						window.removeEventListener('scroll', schedule);
						window.removeEventListener('resize', schedule);
					}
				}

				function schedule() {
					if (queued) return;
					queued = true;
					window.requestAnimationFrame(reveal);
				}

				window.addEventListener('scroll', schedule, { passive: true });
				window.addEventListener('resize', schedule);
				reveal();
			})();
		</script>
	</body>
</html>
