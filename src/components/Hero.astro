---
import AgentConsole from './AgentConsole.astro';
import { coreSkills, otherSkillCount } from '../data/skills';

---

{/* Spacing and the trace come from the TraceSection around it (index.astro). */}
<div data-hero>
	<script is:inline>
		// Decide before the name renders whether the boot sequence plays: only
		// with motion allowed, and only once per browser session.
		(function () {
			if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
			try {
				if (sessionStorage.getItem('hero-booted')) return;
				sessionStorage.setItem('hero-booted', '1');
			} catch (e) {
				// Storage blocked: play it, just not remembered.
			}
			document.documentElement.setAttribute('data-hero-booting', '');
		})();
	</script>
	<svg class="boot" data-boot-svg aria-hidden="true"></svg>
	<div class="relative z-[1] grid items-center gap-10 lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] lg:gap-14">
		<div>
			<p class="kicker text-[var(--accent)]">
				Full-Stack-Entwickler in Düsseldorf
			</p>
			{/* Name and portrait as one unit. The photo is portrait (3:4) and about as
			    tall as the two-line name, so the two read as a pair, not as a
			    thumbnail next to a heading. */}
			<div class="mt-5 flex flex-wrap items-center gap-5 sm:gap-6">
				<h1 data-boot-name class="hero-name">
					{/* One span per letter so the boot sequence can light them one by one;
					    hidden from screen readers, which get the whole name instead. */}
					<span aria-hidden="true">{[...'Henrik'].map((c) => <span class="ch">{c}</span>)}</span><br />
					<span aria-hidden="true">{[...'Grosche'].map((c) => <span class="ch">{c}</span>)}</span>
					<span class="sr-only">Henrik Grosche</span>
				</h1>
				<img
					src="/profile.webp"
					alt="Porträtfoto von Henrik Grosche"
					width="96"
					height="128"
					fetchpriority="high"
					class="h-[6.5rem] w-[4.875rem] shrink-0 rounded-xl border border-[var(--color-border-strong)] object-cover object-top sm:h-32 sm:w-24"
				/>
			</div>
			<div data-boot-after class="pt-2">
			<p data-boot-step style="--boot-delay: 0ms" class="hero-intro mt-6">
				Ich baue Systeme und verbinde sie zu automatisierten Workflows, zunehmend mit{' '}
				<strong><span class="whitespace-nowrap">KI-Agenten</span>, die man messen und kontrollieren kann.</strong>
			</p>
			<div data-boot-step style="--boot-delay: 140ms" class="mt-7 flex flex-wrap items-center gap-3">
				<a
					href="#projects"
					class="inline-flex min-h-11 items-center rounded-md bg-[var(--color-accent)] px-4 py-2.5 text-sm font-medium text-[var(--color-bg)] transition-opacity hover:opacity-85"
				>
					Projekte ansehen
				</a>
				<a
					href="/cv-henrik-grosche.pdf"
					download
					class="inline-flex min-h-11 items-center rounded-md border border-[var(--color-border-strong)] px-4 py-2.5 text-sm font-medium text-[var(--color-text)] transition-colors hover:border-[var(--color-accent)] hover:text-[var(--color-accent)]"
				>
					Lebenslauf (PDF)
				</a>
			</div>

			{/* Only the core stack here; the long tail sits under the career timeline,
			    so the hero makes one claim instead of listing everything. */}
			{/* Plain text, not chips: chips on this page are filter buttons, and these are not clickable. */}
			<p data-boot-step style="--boot-delay: 280ms" class="hero-stack mt-7">
				<span class="sr-only">Kern-Stack: </span>
				{coreSkills.map((skill) => <span class="item">{skill.name}</span>)}
				<a href="#erfahrung" class="more">und {otherSkillCount} weitere</a>
			</p>
			</div>
		</div>

		<figure class="m-0" data-boot-target data-boot-step style="--boot-delay: 460ms">
			<AgentConsole />
			<figcaption class="mt-3 text-sm leading-relaxed text-[var(--color-text-muted)]">
				Ein echter Ablauf aus dem{' '}
				<a href="/projects/ai-trip-planer" class="text-[var(--color-accent)] hover:underline">AI Trip Planner</a>: Jede Zeile im Log schickt ein Paket durch den Aufbau darüber.
			</figcaption>
		</figure>
	</div>

	<script is:inline>
		(function () {
			const hero = document.querySelector('[data-hero]');
			const svg = hero.querySelector('[data-boot-svg]');
			const name = hero.querySelector('[data-boot-name]');
			const target = hero.querySelector('[data-boot-target]');
			const chars = [...name.querySelectorAll('.ch')];
			const root = document.documentElement;
			const booting = root.hasAttribute('data-hero-booting');
			const sleep = (ms) => new Promise((resolve) => setTimeout(resolve, ms));
			let animating = false;
			let consoleStarted = false;

			// Shows the text and lets the agent console start. Safe to call twice.
			function reveal() {
				root.removeAttribute('data-hero-booting');
			}
			function startConsole() {
				if (consoleStarted) return;
				consoleStarted = true;
				reveal();
				document.dispatchEvent(new Event('hero:booted'));
			}
			// Fail-safe: whatever happens (hidden tab, error), never stay in the boot state.
			if (booting) setTimeout(startConsole, 6500);

			// The static part of the trace (the line in from the left, the node and
			// the line down) is drawn by the TraceSection around the hero. This svg
			// draws the same lead-in once more so the boot sequence can animate it,
			// plus the branch under the name to the console. The svg sits in
			// <main>, so coordinates are relative to its top-left corner.
			const node = hero.closest('.trace-section')?.querySelector('[data-trace-node]');
			function layout() {
				if (!node) {
					svg.innerHTML = '';
					return [];
				}
				const origin = svg.getBoundingClientRect();
				const box = hero.getBoundingClientRect();
				const n = name.getBoundingClientRect();
				const t = target.getBoundingClientRect();
				const k = node.getBoundingClientRect();
				svg.style.height = `${box.bottom - origin.top}px`;

				// From the page edge to the node, as in the prototype.
				const padX = k.left - origin.left + k.width / 2;
				const y = k.top - origin.top + k.height / 2;
				const segments = [`M0 ${y} H${padX}`];
				let end = null;

				// Second leg only when the console sits beside the name (desktop):
				// down the trace into the gap between the name row and the text
				// below it, across under name and photo, and into a pad just outside
				// the console's left edge (never into the console itself).
				if (t.top < n.bottom) {
					const row = name.parentElement.getBoundingClientRect();
					const after = hero.querySelector('[data-boot-after] p').getBoundingClientRect();
					const gapY = (row.bottom + after.top) / 2 - origin.top;
					const endX = t.left - origin.left - 10;
					// Enter at the gap's height if the console reaches that far, else as close as it gets.
					const enterY = Math.min(Math.max(gapY, t.top - origin.top + 24), t.bottom - origin.top - 24);
					end = { x: endX, y: enterY };
					segments.push(
						enterY === gapY
							? `M${padX} ${y} V${gapY} H${endX}`
							: `M${padX} ${y} V${gapY} H${endX - 16} V${enterY} H${endX}`,
					);
				}

				const pad = (x, py) =>
					`<circle class="boot-pad" cx="${x}" cy="${py}" r="6"/><circle class="boot-pad-in" cx="${x}" cy="${py}" r="2.5"/>`;
				// Only the lead-in gets the grey track to fill: the branch starts on
				// the copper trace line, where a grey track would show through.
				svg.innerHTML =
					segments
						.map((d, i) => `${i === 0 ? `<path class="boot-line" d="${d}"/>` : ''}<path class="boot-fill" d="${d}"/>`)
						.join('') + (end ? pad(end.x, end.y) : '');
				return [...svg.querySelectorAll('.boot-fill')];
			}

			// Timings from the prototype (ms).
			const LEG1 = 700;
			const LEG2 = 650;
			const LETTERS_AT = 450;
			const STAGGER = 45;
			const PACKET_RUN = 2600;

			// Hides a leg so it can be drawn in, and returns its length.
			function prepare(leg) {
				const length = leg.getTotalLength();
				leg.style.strokeDasharray = `${length}`;
				leg.style.strokeDashoffset = `${length}`;
				return length;
			}

			// Draws a leg in with a CSS transition rather than a JS loop, so the
			// browser can animate it smoothly even while the page is still busy.
			function draw(leg, ms) {
				leg.getBoundingClientRect(); // commit the hidden start state first
				leg.style.transition = `stroke-dashoffset ${ms}ms cubic-bezier(.6, .1, .3, 1)`;
				leg.style.strokeDashoffset = '0';
			}

			// The glowing dot: one pass over the whole trace once it is built,
			// then it is removed for good.
			function runPacket(legs) {
				const lengths = legs.map((leg) => leg.getTotalLength());
				const total = lengths.reduce((sum, l) => sum + l, 0);
				svg.insertAdjacentHTML('beforeend', '<circle class="boot-packet" r="3.5" cx="-20" cy="-20"/>');
				const packet = svg.querySelector('.boot-packet');
				const start = performance.now();
				(function frame(now) {
					const t = Math.min(1, (now - start) / PACKET_RUN);
					let d = t * total;
					let i = 0;
					while (i < legs.length - 1 && d > lengths[i]) {
						d -= lengths[i];
						i += 1;
					}
					const p = legs[i].getPointAtLength(d);
					packet.setAttribute('cx', p.x);
					packet.setAttribute('cy', p.y);
					if (t < 1) requestAnimationFrame(frame);
					else packet.remove();
				})(start);
			}

			async function boot() {
				animating = true;
				const legs = layout();
				legs.forEach(prepare);

				if (legs[0]) draw(legs[0], LEG1);
				// Letters start just before the line reaches the name, as in the prototype.
				chars.forEach((ch, i) => {
					setTimeout(() => ch.classList.add('lit'), LETTERS_AT + i * STAGGER);
					setTimeout(() => ch.classList.add('set'), LETTERS_AT + i * STAGGER + 700);
				});
				// The text starts while the last letters are still lighting up.
				await sleep(LETTERS_AT + Math.round(chars.length * STAGGER * 0.6));

				reveal();
				if (legs[1]) draw(legs[1], LEG2);
				await sleep(300);
				startConsole();
				await sleep(900);
				if (legs.length) runPacket(legs);
				if (legs.length) await sleep(PACKET_RUN);
				animating = false;
			}

			// Start once the fonts are in and one frame has rendered: before that the
			// name can still shift, and the page is busy loading, which made it stutter.
			// Wait for the fonts at most 300 ms: past that, starting beats a perfect line.
			const fontsOrTimeout = Promise.race([document.fonts ? document.fonts.ready : Promise.resolve(), sleep(300)]);
			if (booting) fontsOrTimeout.then(() => requestAnimationFrame(boot));
			else layout();

			// Keep the trace in place when the layout changes (resize, late fonts).
			const redraw = () => {
				if (!animating) layout();
			};
			window.addEventListener('resize', redraw);
			if (document.fonts) document.fonts.ready.then(redraw);
		})();
	</script>

</div>

<style>
	/* Display face at poster size: the name is the first thing on the page. */
	.hero-name {
		margin: 0;
		font-family: var(--font-display);
		font-size: var(--text-hero);
		font-weight: 700;
		line-height: 0.9;
		letter-spacing: -0.035em;
		color: var(--ink);
	}

	.hero-intro {
		font-family: var(--font-sans);
		font-size: var(--text-intro);
		font-weight: 400;
		line-height: 1.4;
		color: var(--ink);
	}

	.hero-stack {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.25rem 0;
		max-width: 38rem;
		font: 13px/1.6 var(--font-mono);
		color: var(--ink);
	}

	/* A copper dot after each item, like the pads on the trace. After, not
	   before: when the row wraps, a dot never starts the new line. */
	.hero-stack .item:not(:last-of-type)::after {
		content: '';
		display: inline-block;
		width: 4px;
		height: 4px;
		margin: 0 0.65rem;
		vertical-align: middle;
		border-radius: 50%;
		background-color: var(--accent);
	}

	.hero-stack .more {
		display: inline-flex;
		align-items: center;
		min-height: 2.75rem;
		margin-left: 0.9rem;
		font-family: var(--font-sans);
		font-size: 14px;
		color: var(--muted);
		text-decoration: underline;
		text-decoration-color: color-mix(in srgb, var(--muted) 40%, transparent);
		text-underline-offset: 3px;
	}

	.hero-stack .more:hover {
		color: var(--accent);
		text-decoration-color: var(--accent);
	}

	.hero-intro strong {
		font-weight: 500;
		color: var(--accent);
	}
</style>
