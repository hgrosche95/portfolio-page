---
import AgentConsole from './AgentConsole.astro';

/**
 * Skills grouped by domain rather than listed as one flat row, so the core
 * stack reads louder than the long tail. `core: true` marks the technologies
 * the intro paragraph actually claims as primary.
 */
const skillGroups = [
	{
		label: 'Frontend',
		skills: [
			{ name: 'TypeScript', core: true },
			{ name: 'React', core: true },
			{ name: 'Next.js', core: true },
			{ name: 'JavaScript', core: false },
			{ name: 'HTML', core: false },
			{ name: 'CSS', core: false },
		],
	},
	{
		label: 'Backend',
		skills: [
			{ name: 'Node.js', core: true },
			{ name: 'NestJS', core: true },
			{ name: 'SQL', core: false },
			{ name: 'Java', core: false },
			{ name: 'PHP', core: false },
			{ name: 'Python', core: false },
		],
	},
	{
		label: 'DevOps & Tools',
		skills: [
			{ name: 'CI/CD', core: true },
			{ name: 'Docker', core: false },
			{ name: 'Git / GitLab', core: false },
			{ name: 'Linux', core: false },
			{ name: 'Claude', core: false },
			{ name: 'Copilot', core: false },
		],
	},
	{
		label: 'CMS',
		skills: [
			{ name: 'TYPO3', core: false },
			{ name: 'WordPress', core: false },
		],
	},
];
---

<section
	class="mx-auto max-w-5xl px-4 pt-14 pb-20 sm:pt-20"
	data-xray="Hero.astro · statisch"
	data-xray-kind="static"
	data-xray-pos="inside"
	data-hero
>
	<script is:inline>
		// Decide before the name renders whether the boot sequence plays: only
		// with motion allowed, and only once per browser session.
		(function () {
			if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
			try {
				if (sessionStorage.getItem('hero-booted')) return;
				sessionStorage.setItem('hero-booted', '1');
			} catch (e) {
				// Storage blocked: play it, just not remembered.
			}
			document.documentElement.setAttribute('data-hero-booting', '');
		})();
	</script>
	<svg class="boot" data-boot-svg aria-hidden="true"></svg>
	<div class="relative z-[1] grid items-center gap-10 lg:grid-cols-2 lg:gap-14">
		<div data-reveal>
			<p class="font-mono text-xs tracking-widest text-[var(--color-accent)] uppercase">
				Full-Stack-Entwickler · Düsseldorf
			</p>
			{/* Name and portrait as one unit. The photo is portrait (3:4) and about as
			    tall as the two-line name, so the two read as a pair, not as a
			    thumbnail next to a heading. */}
			<div class="mt-5 flex items-center gap-5 sm:gap-6">
				<h1
					data-boot-name
					class="font-sans text-5xl leading-[0.95] font-semibold tracking-tight text-[var(--color-text)] sm:text-6xl"
				>
					{/* Plex Sans rather than the display face: the name reads as a plain,
					    confident statement; Bricolage stays for section headings. */}
					{/* One span per letter so the boot sequence can light them one by one;
					    hidden from screen readers, which get the whole name instead. */}
					<span aria-hidden="true">{[...'Henrik'].map((c) => <span class="ch">{c}</span>)}</span><br />
					<span aria-hidden="true">{[...'Grosche'].map((c) => <span class="ch">{c}</span>)}</span>
					<span class="sr-only">Henrik Grosche</span>
				</h1>
				<img
					src="/profile.webp"
					alt="Porträtfoto von Henrik Grosche"
					width="96"
					height="128"
					fetchpriority="high"
					class="h-[6.5rem] w-[4.875rem] shrink-0 rounded-xl border border-[var(--color-border-strong)] object-cover object-top sm:h-32 sm:w-24"
				/>
			</div>
			<div data-boot-after>
			<p class="mt-4 text-lg leading-snug text-[var(--color-text)] sm:text-xl">
				Ich baue Systeme und verbinde sie zu automatisierten Workflows, zunehmend mit{' '}
				<span class="whitespace-nowrap">KI-Agenten</span>, die man messen und kontrollieren kann.
			</p>
			<p class="mt-4 text-base leading-relaxed text-[var(--color-text-muted)]">
				Von React/TypeScript-Frontends über Node.js-Backends bis zur Integration verschiedenster
				APIs und Drittsysteme. Technische Herausforderungen reizen mich; neue Technologien und
				Cloud-Umgebungen eigne ich mir schnell und eigenständig an.
			</p>

			<div class="mt-7 flex flex-wrap items-center gap-3">
				<a
					href="#projects"
					class="rounded-md bg-[var(--color-accent)] px-4 py-2 font-mono text-sm font-medium text-[var(--color-bg)] transition-opacity hover:opacity-85"
				>
					Projekte ansehen
				</a>
				<a
					href="/cv-henrik-grosche.pdf"
					download
					class="rounded-md border border-[var(--color-border-strong)] px-4 py-2 font-mono text-sm text-[var(--color-text)] transition-colors hover:border-[var(--color-accent)] hover:text-[var(--color-accent)]"
				>
					Lebenslauf (PDF)
				</a>
				<a
					href="#kontakt"
					class="font-mono text-sm text-[var(--color-text-muted)] underline-offset-4 transition-colors hover:text-[var(--color-accent)] hover:underline"
				>
					Kontakt
				</a>
			</div>
			</div>
		</div>

		<figure data-reveal class="m-0" data-boot-target>
			<AgentConsole />
			<figcaption class="mt-3 text-sm leading-relaxed text-[var(--color-text-muted)]">
				Ein echter Ablauf aus dem{' '}
				<a href="/projects/ai-trip-planer" class="text-[var(--color-accent)] hover:underline">AI Trip Planner</a>: Jede Zeile im Log schickt ein Paket durch den Aufbau darüber.
			</figcaption>
		</figure>
	</div>

	<script is:inline>
		(function () {
			const hero = document.querySelector('[data-hero]');
			const svg = hero.querySelector('[data-boot-svg]');
			const name = hero.querySelector('[data-boot-name]');
			const target = hero.querySelector('[data-boot-target]');
			const chars = [...name.querySelectorAll('.ch')];
			const root = document.documentElement;
			const booting = root.hasAttribute('data-hero-booting');
			const sleep = (ms) => new Promise((resolve) => setTimeout(resolve, ms));
			let animating = false;
			let consoleStarted = false;

			// Shows the text and lets the agent console start. Safe to call twice.
			function reveal() {
				root.removeAttribute('data-hero-booting');
			}
			function startConsole() {
				if (consoleStarted) return;
				consoleStarted = true;
				reveal();
				document.dispatchEvent(new Event('hero:booted'));
			}
			// Fail-safe: whatever happens (hidden tab, error), never stay in the boot state.
			if (booting) setTimeout(startConsole, 4500);

			// Draws the trace for the current layout. The svg sits in <main>, so
			// coordinates are relative to its top-left corner.
			function layout() {
				const origin = svg.getBoundingClientRect();
				const box = hero.getBoundingClientRect();
				const n = name.getBoundingClientRect();
				const t = target.getBoundingClientRect();
				svg.style.height = `${box.bottom - origin.top}px`;

				// Start on the margin trace when it is shown, else at the page edge.
				const margin = document.getElementById('trace');
				const m = margin ? margin.getBoundingClientRect() : null;
				const startX = m && m.width ? m.left + m.width / 2 - origin.left : 0;
				const padX = n.left - origin.left - 18;
				const y = n.top - origin.top + n.height / 2;
				const segments = [`M${startX} ${y} H${padX}`];
				let end = null;

				// Second leg only when the console sits beside the name (desktop):
				// down into the gap between the name row and the text below it,
				// across under name and photo, and into a pad just outside the
				// console's left edge (never into the console itself).
				if (t.top < n.bottom) {
					const row = name.parentElement.getBoundingClientRect();
					const after = hero.querySelector('[data-boot-after]').getBoundingClientRect();
					const gapY = (row.bottom + after.top) / 2 - origin.top;
					const endX = t.left - origin.left - 10;
					// Enter at the gap's height if the console reaches that far, else as close as it gets.
					const enterY = Math.min(Math.max(gapY, t.top - origin.top + 24), t.bottom - origin.top - 24);
					end = { x: endX, y: enterY };
					segments.push(
						enterY === gapY
							? `M${padX} ${y} V${gapY} H${endX}`
							: `M${padX} ${y} V${gapY} H${endX - 16} V${enterY} H${endX}`,
					);
				}

				const pad = (x, py) =>
					`<circle class="boot-pad" cx="${x}" cy="${py}" r="5"/><circle class="boot-pad-in" cx="${x}" cy="${py}" r="2"/>`;
				svg.innerHTML =
					segments.map((d) => `<path class="boot-line" d="${d}"/><path class="boot-fill" d="${d}"/>`).join('') +
					pad(padX, y) +
					(end ? pad(end.x, end.y) : '');
				return [...svg.querySelectorAll('.boot-fill')];
			}

			// Draws one leg with the packet riding its tip.
			function drawAlong(path, packet, ms) {
				const length = path.getTotalLength();
				const start = performance.now();
				return new Promise((resolve) => {
					(function frame(now) {
						const t = Math.min(1, (now - start) / ms);
						const eased = 1 - Math.pow(1 - t, 3);
						path.style.strokeDashoffset = `${length * (1 - eased)}`;
						const p = path.getPointAtLength(length * eased);
						packet.setAttribute('cx', p.x);
						packet.setAttribute('cy', p.y);
						if (t < 1) requestAnimationFrame(frame);
						else resolve();
					})(start);
				});
			}

			async function boot() {
				animating = true;
				const legs = layout();
				for (const leg of legs) {
					const length = leg.getTotalLength();
					leg.style.strokeDasharray = `${length}`;
					leg.style.strokeDashoffset = `${length}`;
				}
				svg.insertAdjacentHTML('beforeend', '<circle class="boot-packet" r="3.5" cx="-20" cy="-20"/>');
				const packet = svg.querySelector('.boot-packet');

				await drawAlong(legs[0], packet, 700);
				chars.forEach((ch, i) => {
					setTimeout(() => ch.classList.add('lit'), i * 55);
					setTimeout(() => ch.classList.add('set'), i * 55 + 650);
				});
				await sleep(chars.length * 55 + 200);
				reveal();
				if (legs[1]) await drawAlong(legs[1], packet, 650);
				// The dot only runs this once, then it is gone for good.
				packet.remove();
				animating = false;
				startConsole();
			}

			if (booting) boot();
			else layout();

			// Keep the trace in place when the layout changes (resize, late fonts).
			const redraw = () => {
				if (!animating) layout();
			};
			window.addEventListener('resize', redraw);
			if (document.fonts) document.fonts.ready.then(redraw);
		})();
	</script>

	<div data-reveal class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
		{
			skillGroups.map((group) => (
				<div>
					<p class="font-mono text-xs tracking-wider text-[var(--color-text-muted)] uppercase">
						{group.label}
					</p>
					<div class="mt-3 flex flex-wrap gap-1.5">
						{group.skills.map((skill) => (
							<span
								class:list={[
									'rounded border px-2 py-0.5 font-mono text-xs transition-colors',
									skill.core
										? 'border-[var(--color-accent)] bg-[var(--color-accent-soft)] text-[var(--color-accent)]'
										: 'border-[var(--color-border)] text-[var(--color-text-muted)]',
								]}
							>
								{skill.name}
							</span>
						))}
					</div>
				</div>
			))
		}
	</div>
</section>
