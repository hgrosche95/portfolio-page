---
import type { CollectionEntry } from 'astro:content';
import Schematic from './Schematic.astro';

type Architecture = NonNullable<CollectionEntry<'projects'>['data']['architecture']>;

/*
 * The hero's diagram: the encounter agent from agentic-rogue-like, cut down
 * to the part that makes the point - the model is swappable, the guardrails
 * around it are not. Kept here rather than in that project's MDX because it
 * is a deliberate simplification (engine, map and combat collapsed into one
 * box), not the project's real architecture.
 */
const encounterAgent: Architecture = {
	lanes: ['Spielkern', 'Agent', 'Modell'],
	nodes: [
		{ id: 'engine', label: 'Run-Engine', kind: 'backend', sub: 'Etage · Budget', lane: 0, row: 0.6 },
		{ id: 'agent', label: 'Encounter-Agent', kind: 'backend', sub: 'LangGraph', lane: 1, row: 0 },
		{ id: 'check', label: 'Validierung', kind: 'backend', sub: 'Schema + Budget', lane: 1, row: 1.4 },
		{ id: 'groq', label: 'Groq', kind: 'external', sub: 'gpt-oss-20b · Cloud', lane: 2, row: 0 },
		{ id: 'local', label: 'Qwen2.5-1.5B', kind: 'external', sub: 'QLoRA · lokal', lane: 2, row: 1.4 },
	],
	edges: [
		['engine', 'agent'],
		['agent', 'groq'],
		['agent', 'local'],
		['agent', 'check'],
		['check', 'engine'],
	],
	scenarios: [
		{
			name: 'Cloud (Groq)',
			steps: [
				{ from: 'engine', to: 'agent', label: 'Etage + Budget' },
				{ from: 'agent', to: 'groq', label: 'Tool-Call', detail: 'festes Schema' },
				{ from: 'groq', to: 'agent', label: 'Vorschlag' },
				{ from: 'agent', to: 'check', label: 'Prüfen' },
				{ from: 'check', to: 'check', label: 'Bei Verstoß', detail: 'Retry, höchstens dreimal' },
				{ from: 'check', to: 'engine', label: 'Gegner', detail: 'sonst statischer Pool' },
			],
		},
		{
			name: 'Lokal (Fine-Tune)',
			steps: [
				{ from: 'engine', to: 'agent', label: 'Etage + Budget' },
				{ from: 'agent', to: 'local', label: 'Tool-Call', detail: 'dieselben Tools, ohne Netzwerk' },
				{ from: 'local', to: 'agent', label: 'Vorschlag' },
				{ from: 'agent', to: 'check', label: 'Prüfen' },
				{ from: 'check', to: 'check', label: 'Bei Verstoß', detail: 'Retry, höchstens dreimal' },
				{ from: 'check', to: 'engine', label: 'Gegner', detail: 'sonst statischer Pool' },
			],
		},
	],
};

/** What changes with the model, from training/RESULTS.md in that repo. Same order as the scenarios. */
const metrics = [
	[
		{ value: 'Standard', label: 'in Produktion' },
		{ value: '310 Aufrufe', label: 'als Baseline gemessen' },
		{ value: 'Cent-Beträge', label: 'braucht Netz + API-Key' },
	],
	[
		{ value: '100 %', label: 'schemakonform, 604 Aufrufe' },
		{ value: '935 MB', label: 'GGUF, lokal über Ollama' },
		{ value: 'Vielfalt ↓', label: 'dokumentierter Zielkonflikt' },
	],
];

/**
 * Skills grouped by domain rather than listed as one flat row, so the core
 * stack reads louder than the long tail. `core: true` marks the technologies
 * the intro paragraph actually claims as primary.
 */
const skillGroups = [
	{
		label: 'Frontend',
		skills: [
			{ name: 'TypeScript', core: true },
			{ name: 'React', core: true },
			{ name: 'Next.js', core: true },
			{ name: 'JavaScript', core: false },
			{ name: 'HTML', core: false },
			{ name: 'CSS', core: false },
		],
	},
	{
		label: 'Backend',
		skills: [
			{ name: 'Node.js', core: true },
			{ name: 'NestJS', core: true },
			{ name: 'SQL', core: false },
			{ name: 'Java', core: false },
			{ name: 'PHP', core: false },
			{ name: 'Python', core: false },
		],
	},
	{
		label: 'DevOps & Tools',
		skills: [
			{ name: 'CI/CD', core: true },
			{ name: 'Docker', core: false },
			{ name: 'Git / GitLab', core: false },
			{ name: 'Linux', core: false },
			{ name: 'Claude', core: false },
			{ name: 'Copilot', core: false },
		],
	},
	{
		label: 'CMS',
		skills: [
			{ name: 'TYPO3', core: false },
			{ name: 'WordPress', core: false },
		],
	},
];
---

<section
	class="mx-auto max-w-5xl px-4 pt-14 pb-20 sm:pt-20"
	data-xray="Hero.astro · statisch"
	data-xray-kind="static"
	data-xray-pos="inside"
>
	<div class="grid items-center gap-10 lg:grid-cols-2 lg:gap-14">
		<div data-reveal>
			<p class="font-mono text-xs tracking-widest text-[var(--color-accent)] uppercase">
				Full-Stack-Entwickler · Düsseldorf
			</p>
			{/* Name and portrait as one unit. The photo is portrait (3:4) and about as
			    tall as the two-line name, so the two read as a pair, not as a
			    thumbnail next to a heading. */}
			<div class="mt-5 flex items-center gap-5 sm:gap-6">
				<h1
					class="font-sans text-5xl leading-[0.95] font-semibold tracking-tight text-[var(--color-text)] sm:text-6xl"
				>
					{/* Plex Sans rather than the display face: the name reads as a plain,
					    confident statement; Bricolage stays for section headings. */}
					Henrik<br />Grosche
				</h1>
				<img
					src="/profile.webp"
					alt="Porträtfoto von Henrik Grosche"
					width="96"
					height="128"
					fetchpriority="high"
					class="h-[6.5rem] w-[4.875rem] shrink-0 rounded-xl border border-[var(--color-border-strong)] object-cover object-top sm:h-32 sm:w-24"
				/>
			</div>
			<p class="mt-4 text-lg leading-snug text-[var(--color-text)] sm:text-xl">
				Ich baue Systeme und verbinde sie zu automatisierten Workflows, zunehmend mit{' '}
				<span class="whitespace-nowrap">KI-Agenten</span>, die man messen und kontrollieren kann.
			</p>
			<p class="mt-4 text-base leading-relaxed text-[var(--color-text-muted)]">
				Von React/TypeScript-Frontends über Node.js-Backends bis zur Integration verschiedenster
				APIs und Drittsysteme. Technische Herausforderungen reizen mich; neue Technologien und
				Cloud-Umgebungen eigne ich mir schnell und eigenständig an.
			</p>

			<div class="mt-7 flex flex-wrap items-center gap-3">
				<a
					href="#projects"
					class="rounded-md bg-[var(--color-accent)] px-4 py-2 font-mono text-sm font-medium text-[var(--color-bg)] transition-opacity hover:opacity-85"
				>
					Projekte ansehen
				</a>
				<a
					href="/cv-henrik-grosche.pdf"
					download
					class="rounded-md border border-[var(--color-border-strong)] px-4 py-2 font-mono text-sm text-[var(--color-text)] transition-colors hover:border-[var(--color-accent)] hover:text-[var(--color-accent)]"
				>
					Lebenslauf (PDF)
				</a>
				<a
					href="#kontakt"
					class="font-mono text-sm text-[var(--color-text-muted)] underline-offset-4 transition-colors hover:text-[var(--color-accent)] hover:underline"
				>
					Kontakt →
				</a>
			</div>
		</div>

		<figure data-reveal class="m-0" data-hero-schematic>
			<Schematic architecture={encounterAgent} width={520} compact scenarioLabel="Modell:" />
			{/* One strip per scenario; the script below shows the one that is playing. */}
			{
				metrics.map((set, i) => (
					<dl
						data-metrics={i}
						hidden={i !== 0}
						class="mt-2 grid grid-cols-3 overflow-hidden rounded-lg border border-[var(--color-border-strong)] bg-[var(--color-surface)] text-xs"
					>
						{set.map((metric) => (
							<div class="border-l border-dashed border-[var(--color-border-strong)] px-3 py-2 first:border-l-0">
								<dt class="sr-only">{metric.label}</dt>
								<dd class="font-display text-base font-semibold tracking-tight text-[var(--color-text)]">
									{metric.value}
								</dd>
								<dd class="leading-snug text-[var(--color-text-muted)]" aria-hidden="true">
									{metric.label}
								</dd>
							</div>
						))}
					</dl>
				))
			}
			<figcaption class="mt-3 text-sm leading-relaxed text-[var(--color-text-muted)]">
				Ein echtes Stück aus dem{' '}
				<a href="/projects/agentic-rogue-like" class="text-[var(--color-accent)] hover:underline">Agentic Roguelike</a>: Das Modell lässt sich umschalten, die Leitplanken drumherum bleiben gleich.
			</figcaption>
		</figure>
	</div>

	<script is:inline>
		(function () {
			const hero = document.querySelector('[data-hero-schematic]');
			if (!hero) return;
			const schematic = hero.querySelector('[data-schematic]');
			const strips = hero.querySelectorAll('[data-metrics]');
			schematic.addEventListener('schematic:play', function (event) {
				strips.forEach(function (strip, i) {
					strip.hidden = i !== event.detail.index;
				});
			});
		})();
	</script>

	<div data-reveal class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
		{
			skillGroups.map((group) => (
				<div>
					<p class="font-mono text-xs tracking-wider text-[var(--color-text-muted)] uppercase">
						{group.label}
					</p>
					<div class="mt-3 flex flex-wrap gap-1.5">
						{group.skills.map((skill) => (
							<span
								class:list={[
									'rounded border px-2 py-0.5 font-mono text-xs transition-colors',
									skill.core
										? 'border-[var(--color-accent)] bg-[var(--color-accent-soft)] text-[var(--color-accent)]'
										: 'border-[var(--color-border)] text-[var(--color-text-muted)]',
								]}
							>
								{skill.name}
							</span>
						))}
					</div>
				</div>
			))
		}
	</div>
</section>
