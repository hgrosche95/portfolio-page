---
/**
 * ⌘K/Strg+K-Schnellsuche über alle Projekte. Wie ProjectFilter.astro bewusst
 * kein React-Island: die Trefferliste ist reines HTML aus echten
 * Projekt-Daten, kein State, den ein Framework verwalten müsste - ein
 * getipptes Inline-Skript reicht, ohne zusätzliches JS-Bundle.
 */
export interface SearchProject {
	slug: string;
	title: string;
	summary: string;
	tech: string[];
}

interface Props {
	projects: SearchProject[];
}

const { projects } = Astro.props;
---

<button
	type="button"
	id="cmdk-trigger"
	aria-haspopup="dialog"
	aria-label="Projekte durchsuchen"
	class="flex items-center gap-1.5 rounded-md border border-[var(--color-border)] px-2 py-1 text-[var(--color-text-muted)] transition-colors hover:border-[var(--color-accent)] hover:text-[var(--color-accent)]"
>
	<svg
		class="size-3.5"
		viewBox="0 0 24 24"
		fill="none"
		stroke="currentColor"
		stroke-width="2"
		stroke-linecap="round"
		aria-hidden="true"
	>
		<circle cx="11" cy="11" r="7"></circle>
		<path d="m21 21-4.3-4.3"></path>
	</svg>
</button>

<div id="cmdk-backdrop" class="fixed inset-0 z-[60] hidden bg-black/50" data-cmdk-close></div>
<div
	id="cmdk-modal"
	role="dialog"
	aria-modal="true"
	aria-label="Projektsuche"
	class="fixed inset-x-4 top-24 z-[61] mx-auto hidden max-w-md rounded-lg border border-[var(--color-border)] bg-[var(--color-surface)] shadow-lg"
>
	<div class="flex items-center gap-2 border-b border-[var(--color-border)] px-3 py-2.5">
		<svg
			class="size-4 shrink-0 text-[var(--color-text-muted)]"
			viewBox="0 0 24 24"
			fill="none"
			stroke="currentColor"
			stroke-width="2"
			stroke-linecap="round"
			aria-hidden="true"
		>
			<circle cx="11" cy="11" r="7"></circle>
			<path d="m21 21-4.3-4.3"></path>
		</svg>
		<input
			id="cmdk-input"
			type="text"
			placeholder="Projekt oder Technologie…"
			autocomplete="off"
			class="flex-1 bg-transparent font-mono text-sm text-[var(--color-text)] outline-none placeholder:text-[var(--color-text-muted)]"
		/>
		{/* A visible close button; Esc still works as a keyboard shortcut. */}
		<button
			type="button"
			id="cmdk-close"
			aria-label="Suche schließen"
			class="grid size-7 shrink-0 place-items-center rounded text-[var(--color-text-muted)] transition-colors hover:bg-[var(--color-accent-soft)] hover:text-[var(--color-accent)]"
		>
			<svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
				<path d="M18 6 6 18M6 6l12 12"></path>
			</svg>
		</button>
	</div>
	<ul id="cmdk-results" class="max-h-72 overflow-y-auto p-1.5"></ul>
	<p id="cmdk-empty" class="hidden px-3 py-6 text-center font-mono text-xs text-[var(--color-text-muted)]">
		Keine Treffer.
	</p>
</div>

<script define:vars={{ projects }}>
	(function () {
		const trigger = document.getElementById('cmdk-trigger');
		const backdrop = document.getElementById('cmdk-backdrop');
		const modal = document.getElementById('cmdk-modal');
		const input = document.getElementById('cmdk-input');
		const resultsEl = document.getElementById('cmdk-results');
		const emptyEl = document.getElementById('cmdk-empty');
		if (!trigger || !backdrop || !modal || !input || !resultsEl || !emptyEl) return;

		let matches = [];
		let activeIndex = 0;
		let lastFocused = null;

		function escapeHtml(value) {
			const div = document.createElement('div');
			div.textContent = value;
			return div.innerHTML;
		}

		function setActive(index) {
			const items = resultsEl.querySelectorAll('a');
			items.forEach((el) => el.classList.remove('bg-[var(--color-accent-soft)]'));
			const next = items[index];
			if (next) {
				next.classList.add('bg-[var(--color-accent-soft)]');
				next.scrollIntoView({ block: 'nearest' });
			}
			activeIndex = index;
		}

		function render(query) {
			const q = query.trim().toLowerCase();
			matches = !q
				? projects
				: projects.filter((project) =>
						`${project.title} ${project.summary} ${project.tech.join(' ')}`.toLowerCase().includes(q),
					);

			emptyEl.classList.toggle('hidden', matches.length > 0);
			resultsEl.innerHTML = matches
				.map(
					(project, index) => `
						<li>
							<a
								href="/projects/${project.slug}"
								class="block rounded-md px-3 py-2 transition-colors hover:bg-[var(--color-accent-soft)] ${index === 0 ? 'bg-[var(--color-accent-soft)]' : ''}"
							>
								<span class="block text-sm font-medium text-[var(--color-text)]">${escapeHtml(project.title)}</span>
								<span class="block font-mono text-xs text-[var(--color-text-muted)]">${escapeHtml(project.tech.slice(0, 3).join(' · '))}</span>
							</a>
						</li>`,
				)
				.join('');
			activeIndex = 0;
		}

		function open() {
			lastFocused = document.activeElement;
			backdrop.classList.remove('hidden');
			modal.classList.remove('hidden');
			document.body.style.overflow = 'hidden';
			input.value = '';
			render('');
			input.focus();
		}

		function close() {
			backdrop.classList.add('hidden');
			modal.classList.add('hidden');
			document.body.style.overflow = '';
			if (lastFocused instanceof HTMLElement) lastFocused.focus();
		}

		function isOpen() {
			return !modal.classList.contains('hidden');
		}

		trigger.addEventListener('click', open);
		backdrop.addEventListener('click', close);
		document.getElementById('cmdk-close')?.addEventListener('click', close);

		document.addEventListener('keydown', (event) => {
			const isSearchShortcut = (event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k';
			if (isSearchShortcut) {
				event.preventDefault();
				isOpen() ? close() : open();
				return;
			}
			if (!isOpen()) return;

			if (event.key === 'Escape') {
				close();
			} else if (event.key === 'ArrowDown') {
				event.preventDefault();
				setActive(Math.min(activeIndex + 1, matches.length - 1));
			} else if (event.key === 'ArrowUp') {
				event.preventDefault();
				setActive(Math.max(activeIndex - 1, 0));
			} else if (event.key === 'Enter' && matches[activeIndex]) {
				window.location.href = `/projects/${matches[activeIndex].slug}`;
			} else if (event.key === 'Tab') {
				// Minimal focus trap: the input is the only element outside the
				// results list that can hold focus, so Tab/Shift+Tab from either
				// end just bounces back to the input instead of leaking focus
				// onto the page underneath.
				const links = Array.from(resultsEl.querySelectorAll('a'));
				const focusable = [input, ...links];
				const currentIndex = focusable.indexOf(document.activeElement);
				const lastIndex = focusable.length - 1;
				if (!event.shiftKey && currentIndex === lastIndex) {
					event.preventDefault();
					input.focus();
				} else if (event.shiftKey && currentIndex <= 0) {
					event.preventDefault();
					focusable[lastIndex].focus();
				}
			}
		});

		input.addEventListener('input', () => render(input.value));
	})();
</script>
