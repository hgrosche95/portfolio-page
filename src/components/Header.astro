---
import ThemeToggle from './ThemeToggle.astro';

const navLinks = [
	{ href: '/', label: 'home' },
	{ href: '/#projects', label: 'projekte' },
	{ href: '/#kontakt', label: 'kontakt' },
];
---

<header class="border-b border-[var(--color-border)]">
	<div class="mx-auto flex max-w-5xl items-center justify-between px-4 py-4">
		<a href="/" class="font-mono text-sm text-[var(--color-text)]">
			henrik<span class="text-[var(--color-accent)]">.</span>grosche
		</a>
		<nav class="flex items-center gap-4 font-mono text-sm">
			{
				navLinks.map((link) => (
					<a href={link.href} class="text-[var(--color-text-muted)] hover:text-[var(--color-accent)]">
						{link.label}
					</a>
				))
			}
			<ThemeToggle />
		</nav>
	</div>
</header>
