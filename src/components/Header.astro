---
import { getCollection } from 'astro:content';
import CommandSearch from './CommandSearch.astro';
import ThemeToggle from './ThemeToggle.astro';

// Logo + every link + the theme toggle does not fit on a 375px viewport, so the
// least essential link is dropped there rather than letting the bar overflow.
const navLinks = [
	{ href: '/#projects', label: 'projekte', mobile: true },
	{ href: '/#erfahrung', label: 'werdegang', mobile: false },
	{ href: '/#kontakt', label: 'kontakt', mobile: true },
];

// Fetched here rather than passed in as a prop: Header renders on every page
// (project detail pages included), and the search has to work from all of
// them, not just the homepage that already loads this collection for the
// graph. Same "one new file is the only step" principle as the rest of the
// site - this needs no wiring anywhere else when a project is added.
const searchProjects = (await getCollection('projects')).map((entry) => ({
	slug: entry.id,
	title: entry.data.title,
	summary: entry.data.summary,
	tech: entry.data.techStack,
}));
---

<header
	class="sticky top-0 z-50 border-b border-[var(--color-border)] bg-[var(--color-bg-translucent)] backdrop-blur"
>
	<div class="mx-auto flex max-w-5xl items-center justify-between gap-3 px-4 py-3.5">
		<a
			href="/"
			class="shrink-0 font-display text-base font-semibold tracking-tight text-[var(--color-text)] transition-colors hover:text-[var(--color-accent)]"
		>
			henrik<span class="text-[var(--color-accent)]">.</span>grosche
		</a>
		<nav class="flex items-center gap-1 font-mono text-xs sm:gap-2 sm:text-sm">
			{
				navLinks.map((link) => (
					<a
						href={link.href}
						class:list={[
							'rounded px-1.5 py-1 text-[var(--color-text-muted)] transition-colors hover:bg-[var(--color-accent-soft)] hover:text-[var(--color-accent)] sm:px-2',
							link.mobile ? '' : 'hidden sm:inline-block',
						]}
					>
						{link.label}
					</a>
				))
			}
			<CommandSearch projects={searchProjects} />
			<ThemeToggle />
		</nav>
	</div>
</header>
