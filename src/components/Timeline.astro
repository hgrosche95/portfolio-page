<div class="mt-4 space-y-2 font-mono text-sm" data-xray="Timeline.astro · statisch" data-xray-kind="static">
	{
		entries.map((entry) => (
			<details class="group rounded border border-[var(--color-border)] px-4 py-3 open:border-[var(--color-accent)]">
				<summary class="flex cursor-pointer list-none items-center justify-between gap-4">
					<span>
						<span class="text-[var(--color-text)]">{entry.role}</span>{' '}
						<span class="text-[var(--color-text-muted)]">— {entry.company}</span>
					</span>
					<span class="flex shrink-0 items-center gap-2 text-xs">
						<span class="text-[var(--color-accent)]">{entry.period}</span>
						<span class="text-[var(--color-text-muted)] transition-transform group-open:rotate-180">▾</span>
					</span>
				</summary>
				<ul class="mt-3 list-inside list-disc space-y-1 text-xs text-[var(--color-text-muted)]">
					{entry.details.map((detail) => (
						<li>{detail}</li>
					))}
				</ul>
