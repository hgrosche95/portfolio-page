---
// Kept in step with the CV (public/cv-henrik-grosche.pdf).
// An entry without details renders as a plain row instead of a collapsible
// one: there is nothing to open. Add details and it becomes collapsible.
const entries: { role: string; company: string; period: string; details: string[] }[] = [
	{
		role: 'Softwareentwickler für KI-Produkte',
		company: 'opta data',
		period: '11/2026 - heute',
		details: [],
	},
	{
		role: 'KI-Engineering: eigene Projekte',
		company: 'Auswahl, weitere Projekte auf github.com/hgrosche95',
		period: '09/2026 - heute',
		details: [
			'AI Trip Planner: Chat-Agent mit Tool-Use, RAG, MCP-Server und CI-Evals, live auf Azure (NestJS, Next.js, FastAPI, pgvector)',
			'Bewerbungshelfer & Life-Ops-Plattform: LLM-API und MCP-Server für Job-Matching und Anschreiben, per n8n automatisiert (NestJS, n8n)',
			'Agentic Roguelike: LLM-Agent erzeugt Spielinhalte; dafür eigenes Modell destilliert (gpt-oss-20b → Qwen2.5-1.5B, LoRA), lokal via Ollama (Python, LangGraph)',
		],
	},
	{
		role: 'Full-Stack-Entwickler (Manager IT & Web)',
		company: 'iurFRIEND AG, Düsseldorf',
		period: '04/2024 - 08/2026',
		details: [
			'Konzeption, Entwicklung und Pflege von Webseiten, Portalen und internen Anwendungen im juristischen Umfeld (TYPO3, Nextcloud)',
			'Entwicklung und Integration KI-gestützter Anwendungen und Automatisierungen mit OpenAI und Anthropic/Claude Code',
			'Konzeption und Umsetzung einer Systemintegration zwischen Outlook, Nextcloud, Advoware und Brevo zur automatisierten Termin- und Dokumentenverwaltung, inkl. KI-gestützter Klassifizierung eingehender beA-Dokumente',
			'Entwicklung eines Buchungstools für Termine, das die manuelle Terminkoordination im Team deutlich reduziert hat',
			'Anbindung von APIs zwischen internen Systemen (Laravel, Symfony, AngularJS), Weiterentwicklung des CRM- und Funnel-Systems sowie CI/CD mit GitLab und GitHub',
		],
	},
	{
		role: 'Webentwickler',
		company: 'argutus GmbH, Düsseldorf',
		period: '08/2022 - 03/2024',
		details: [
			'Optimierung und Erstellung von Webseiten in TYPO3, Shopify, Shopware und WordPress',
			'Entwicklung containerisierter Anwendungen mit Docker',
			'Versionsverwaltung mit Git und Mitarbeit an automatisierten CI/CD-Deployment-Prozessen, die die Release-Frequenz erhöht haben',
		],
	},
	{
		role: 'Softwareentwickler (Frontend-Schwerpunkt)',
		company: 'Fact Informationssysteme & Consulting AG, Neuss',
		period: '11/2020 - 07/2022',
		details: [
			'Neu- und Weiterentwicklung von Kapitalverwaltungsprodukten für institutionelle Anleger, Versicherungen und Pensionskassen',
			'Frontend-Ausbau fachlich anspruchsvoller Softwarelösungen mit React, TypeScript und CSS',
			'Merge Requests mit GitLab und Release-Steuerung über Jira im Team',
		],
	},
	{
		role: 'Trainee Informationstechnologie',
		company: 'Commerz Real AG, Düsseldorf',
		period: '04/2020 - 10/2020',
		details: [
			'Programmierung von Oberflächen und Datenbankschnittstellen in Frontend und Middleware mit Java und Python',
			'Neuaufsatz eines Java/Python-Entwicklungsstacks sowie funktionale Tests und Modultests',
		],
	},
	{
		role: 'Bachelor Informatik',
		company: 'Heinrich-Heine-Universität, Düsseldorf',
		period: '2020',
		details: ['Bachelorabschluss Informatik'],
	},
	{
		role: 'Praktikum',
		company: 'Heinrich-Heine-Universität, Düsseldorf',
		period: '04/2019 - 08/2019',
		details: ['Implementierung und Pflege von Datenbanken mit PHP und SQL'],
	},
];

// The two most recent stations with details start open: they hold what a reader scans for.
const withDetails = entries.filter((entry) => entry.details.length > 0);
---

<div class="mt-4 space-y-2 text-sm">
	{
		entries.map((entry) => (
			// Each entry is a station on the homepage trace (see .trace-station in global.css).
			<div class="trace-station" style="--station-y: 1.4rem" data-trace-stop>
			{entry.details.length === 0 ? (
				<div class="timeline-static flex min-h-11 flex-col-reverse gap-1 rounded-md border border-[var(--color-accent)] px-4 py-3 sm:flex-row sm:items-start sm:justify-between sm:gap-4">
					<span class="min-w-0">
						<span class="font-medium text-[var(--color-text)] hyphens-auto [overflow-wrap:anywhere]">{entry.role}</span>
						<span class="block text-[var(--color-text-muted)] sm:inline">
							<span class="hidden sm:inline" aria-hidden="true"> · </span>
							{entry.company}
						</span>
					</span>
					<span class="shrink-0 pt-0.5 font-mono text-xs text-[var(--color-accent)] tabular-nums">{entry.period}</span>
				</div>
			) : (
			<details open={withDetails.indexOf(entry) < 2} class="group rounded-md border border-[var(--color-border)] px-4 open:border-[var(--color-accent)]">
				<summary class="flex min-h-11 cursor-pointer list-none flex-col-reverse gap-1 py-3 sm:flex-row sm:items-start sm:justify-between sm:gap-4">
					<span class="min-w-0">
						<span class="font-medium text-[var(--color-text)] hyphens-auto [overflow-wrap:anywhere]">{entry.role}</span>
						<span class="block text-[var(--color-text-muted)] sm:inline">
							<span class="hidden sm:inline" aria-hidden="true"> · </span>
							{entry.company}
						</span>
					</span>
					{/* Dates stay monospace: they are data, and the columns line up. */}
					<span class="flex shrink-0 items-center justify-between gap-2 pt-0.5 font-mono text-xs tabular-nums sm:justify-start">
						<span class="text-[var(--color-accent)]">{entry.period}</span>
						<span class="text-[var(--color-text-muted)] transition-transform group-open:rotate-180" aria-hidden="true">▾</span>
					</span>
				</summary>
				<ul class="pb-3 list-inside list-disc space-y-1 leading-relaxed text-[var(--color-text-muted)]">
					{entry.details.map((detail) => (
						<li>{detail}</li>
					))}
				</ul>
			</details>
			)}
			</div>
		))
	}
</div>
