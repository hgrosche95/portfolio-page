---
/**
 * One stretch of the homepage trace: a narrow column on the left with a 2px
 * copper line, the content on the right. Sections stack without margins, so
 * the lines of neighbouring sections meet and read as one trace from the hero
 * down to the contact form. Each section has a node on its title.
 *
 * - `start`: the line comes in horizontally from the left edge of the
 *   viewport, turns at the node and runs down from there (hero).
 * - `middle`: line over the full height, node at the title.
 * - `end`: line only down to the node, which is larger and filled; nothing
 *   after it (contact).
 *
 * Scroll progress: with the script below running, the line starts grey and
 * fills with copper down to a reading line in the viewport; nodes (sections
 * and the stations in the project list and timeline, see .trace-station in
 * global.css) turn copper once that fill reaches them. Without the script,
 * everything simply stays copper.
 *
 * Purely decorative: the whole column is aria-hidden and ignores the pointer.
 */
interface Props {
	id?: string;
	variant?: 'start' | 'middle' | 'end';
	/** Vertical position of the node, measured from the top of the section. */
	nodeY?: string;
	class?: string;
}

const { id, variant = 'middle', nodeY, class: className } = Astro.props;
---

<section id={id} class:list={['trace-section', className]} data-variant={variant} aria-labelledby={id ? `${id}-title` : undefined}>
	<div class="ts-wrap" style={nodeY ? `--node-y: ${nodeY}` : undefined}>
		<div class="ts-rail" aria-hidden="true">
			{variant === 'start' && <span class="ts-lead" />}
			<span class="ts-line" data-trace-line>
				<span class="ts-signal" />
			</span>
			<span class="ts-node" data-trace-node data-trace-stop />
			{/* End variant only: where the trace terminates when the section has a
			    [data-trace-terminal] (the contact form's send row), placed by the script. */}
			{variant === 'end' && <span class="ts-end-branch" />}
			{variant === 'end' && <span class="ts-end" data-trace-stop />}
		</div>
		<div class="ts-content">
			<slot />
		</div>
	</div>
</section>

<style>
	.trace-section {
		/* The start lead reaches out to the viewport edge; never let it, or
		   anything else, cause sideways scrolling. */
		overflow-x: clip;
	}

	.ts-wrap {
		/* Centre of the first line of a section title (h2, line-height 0.95). */
		--node-y: calc(var(--text-section) * 0.475);
		display: flex;
		max-width: calc(var(--content-max) + 2 * var(--gutter));
		margin-inline: auto;
		padding-inline: var(--gutter);
	}

	.ts-rail {
		position: relative;
		flex: none;
		width: var(--rail-w);
		pointer-events: none;
	}

	/* The spacing sits on the content, not on the wrapper: the rail stretches
	   along with it, so the line runs on into the next section without a gap. */
	/* Above the hero's boot graphic, so the node always sits on top of the line.
	   Elsewhere the rail stays at the bottom, so the station nodes of the
	   project list and timeline (in the content) sit on top of the line. */
	[data-variant='start'] .ts-rail {
		z-index: 2;
	}

	.ts-content {
		flex: 1;
		min-width: 0;
		padding-bottom: var(--section-gap);
	}

	[data-variant='start'] .ts-content {
		padding-top: var(--hero-top);
	}

	.ts-line {
		position: absolute;
		top: 0;
		bottom: 0;
		left: calc(50% - 1px);
		width: 2px;
		background-color: var(--accent);
	}

	/* The copper fill. At rest (no script) it covers the whole line. */
	.ts-line::after {
		content: '';
		position: absolute;
		inset: 0;
		transform-origin: top;
		transform: scaleY(var(--fill, 1));
		background-color: var(--accent);
	}

	/* The hero's stretch is always lit: its branch to the console starts on it. */
	:global(html.trace-live) .ts-line {
		background-color: var(--line);
	}

	:global(html.trace-live) [data-variant='start'] .ts-line::after {
		transform: none;
	}

	/*
	 * The signal: a packet riding the tip of the copper fill, like the one in
	 * the hero console. Shown only on the stretch the reader is in (the
	 * script sets data-signal there), and only with motion allowed.
	 */
	.ts-signal {
		display: none;
	}

	:global(html.trace-live) .ts-line[data-signal] .ts-signal {
		position: absolute;
		z-index: 1;
		top: calc(var(--fill, 0) * 100%);
		left: 50%;
		display: block;
		width: 8px;
		height: 8px;
		translate: -50% -50%;
		border-radius: 50%;
		background-color: var(--ink);
		box-shadow: 0 0 0 3px var(--bg);
	}

	[data-variant='start'] .ts-line {
		top: var(--node-y);
	}

	[data-variant='end'] .ts-line {
		bottom: auto;
		height: var(--node-y);
	}

	/* 100vw to the left of the node: whatever the viewport, it starts off screen. */
	.ts-lead {
		position: absolute;
		top: var(--node-y);
		right: 50%;
		width: 100vw;
		height: 2px;
		translate: 0 -50%;
		background-color: var(--accent);
		transition: opacity 0.3s;
	}

	/* While the hero boot sequence draws this line in, the static one waits. */
	:global(html[data-hero-booting]) .ts-lead {
		opacity: 0;
	}

	.ts-node {
		position: absolute;
		top: var(--node-y);
		left: 50%;
		width: 10px;
		height: 10px;
		translate: -50% -50%;
		border: 2px solid var(--accent);
		border-radius: 50%;
		background-color: var(--bg);
		transition:
			border-color 0.3s,
			background-color 0.3s;
	}

	[data-variant='end'] .ts-node {
		width: 14px;
		height: 14px;
		background-color: var(--accent);
	}

	:global(html.trace-live) .ts-node:not(.reached) {
		border-color: var(--color-border-strong);
	}

	:global(html.trace-live) [data-variant='end'] .ts-node:not(.reached) {
		background-color: var(--color-border-strong);
	}

	/*
	 * Terminal: in an end section with a [data-trace-terminal] the script sets
	 * --end-y and data-terminal, and the trace runs on past the title down to
	 * that row (the contact form's send button), ending in the filled node
	 * there with a short branch to the form. Without the script it stops at
	 * the title as before.
	 */
	.ts-end,
	.ts-end-branch {
		display: none;
	}

	[data-variant='end'] .ts-wrap[data-terminal] .ts-line {
		height: var(--end-y);
	}

	[data-variant='end'] .ts-wrap[data-terminal] .ts-node {
		width: 10px;
		height: 10px;
		background-color: var(--bg);
	}

	:global(html.trace-live) [data-variant='end'] .ts-wrap[data-terminal] .ts-node:not(.reached) {
		background-color: var(--bg);
	}

	.ts-wrap[data-terminal] .ts-end {
		position: absolute;
		z-index: 1;
		top: var(--end-y);
		left: 50%;
		display: block;
		width: 14px;
		height: 14px;
		translate: -50% -50%;
		border: 2px solid var(--accent);
		border-radius: 50%;
		background-color: var(--accent);
		transition: background-color 0.3s;
	}

	:global(html.trace-live) .ts-wrap[data-terminal] .ts-end:not(.reached) {
		background-color: var(--color-border-strong);
		border-color: var(--color-border-strong);
	}

	.ts-wrap[data-terminal] .ts-end-branch {
		position: absolute;
		top: var(--end-y);
		left: 50%;
		display: block;
		width: calc(var(--rail-w) / 2);
		height: 2px;
		translate: 0 -50%;
		background-color: var(--accent);
	}

	/* On a sent message a packet runs from the form along the branch to the end node. */
	.ts-end-branch::after {
		content: '';
		position: absolute;
		top: 50%;
		left: 100%;
		width: 8px;
		height: 8px;
		translate: -50% -50%;
		border-radius: 50%;
		background-color: var(--ink);
		box-shadow: 0 0 0 3px var(--bg);
		opacity: 0;
	}

	.ts-wrap:global(.sending) .ts-end-branch::after {
		animation: send-packet 0.6s ease-in forwards;
	}

	@keyframes send-packet {
		from {
			left: 100%;
			opacity: 1;
		}
		90% {
			opacity: 1;
		}
		to {
			left: 0;
			opacity: 0;
		}
	}

	.ts-end:global(.flash) {
		animation: node-flash 0.7s ease-out;
	}

	/* A node the signal has just reached flashes once (class set by the script). */
	.ts-node:global(.flash) {
		animation: node-flash 0.7s ease-out;
	}

	@keyframes node-flash {
		from {
			box-shadow: 0 0 0 0 color-mix(in srgb, var(--accent) 55%, transparent);
		}
		to {
			box-shadow: 0 0 0 12px color-mix(in srgb, var(--accent) 0%, transparent);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.ts-lead,
		.ts-node {
			transition: none;
		}

		.ts-signal {
			display: none !important;
		}
	}
</style>

<script>
	// Bundled once, however many TraceSections are on the page.
	const READING_LINE = 0.55;
	const root = document.documentElement;
	const lines = Array.from(document.querySelectorAll<HTMLElement>('[data-trace-line]'));
	// The hero's stretch is always lit (see the CSS), so no signal rides it.
	const rideable = new Set(lines.filter((el) => !el.closest('[data-variant="start"]')));
	const stops = Array.from(document.querySelectorAll<HTMLElement>('[data-trace-stop]'));
	const motion = !matchMedia('(prefers-reduced-motion: reduce)').matches;
	// The first pass only records what is already reached on load; flashes
	// and the heading light-up are for nodes the reader scrolls past.
	let settled = false;

	function flash(el: HTMLElement) {
		if (!motion) return;
		el.classList.remove('flash');
		void el.offsetWidth; // restart the animation if it is still running
		el.classList.add('flash');
		el.addEventListener('animationend', () => el.classList.remove('flash'), { once: true });
	}

	/**
	 * A node the signal just reached: flash it, light its section's title once,
	 * and tell the page (the deploy pipeline starts when the signal gets there).
	 */
	function arrive(stop: HTMLElement) {
		document.dispatchEvent(new CustomEvent('trace:arrive', { detail: stop }));
		flash(stop);
		if (!motion || !stop.hasAttribute('data-trace-node')) return;
		const title = stop.closest('.trace-section')?.querySelector<HTMLElement>('[data-letters]');
		if (title && !title.classList.contains('lit')) title.classList.add('lit');
	}

	// End sections whose trace runs on to a terminal row (see the CSS).
	const ends = Array.from(document.querySelectorAll<HTMLElement>('[data-variant="end"]'))
		.map((section) => ({
			wrap: section.querySelector<HTMLElement>('.ts-wrap'),
			terminal: section.querySelector<HTMLElement>('[data-trace-terminal]'),
			node: section.querySelector<HTMLElement>('.ts-end'),
		}))
		.filter((end) => end.wrap && end.terminal && end.node);

	// A message was sent (ContactForm): a packet runs from the form to the end node.
	document.addEventListener('trace:sent', () => {
		for (const { wrap, node } of ends) {
			if (!motion) continue;
			wrap!.classList.remove('sending');
			void wrap!.offsetWidth;
			wrap!.classList.add('sending');
			setTimeout(() => {
				wrap!.classList.remove('sending');
				flash(node!);
			}, 600);
		}
	});

	if (lines.length) {
		root.classList.add('trace-live');
		let queued = false;

		const update = () => {
			queued = false;
			for (const { wrap, terminal } of ends) {
				const t = terminal!.getBoundingClientRect();
				if (!t.height) continue;
				const top = wrap!.getBoundingClientRect().top;
				wrap!.style.setProperty('--end-y', `${(t.top + t.height / 2 - top).toFixed(1)}px`);
				wrap!.setAttribute('data-terminal', '');
			}
			const line = window.innerHeight * READING_LINE;
			// At the very bottom the last nodes may never cross the reading
			// line, so the end of the page counts as fully read.
			const atEnd = window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2;
			for (const el of lines) {
				const box = el.getBoundingClientRect();
				const fill = atEnd ? 1 : Math.max(0, Math.min(1, (line - box.top) / box.height));
				el.style.setProperty('--fill', fill.toFixed(4));
				// The signal rides the stretch the reading line is currently on.
				el.toggleAttribute('data-signal', motion && rideable.has(el) && fill > 0 && fill < 1);
			}
			for (const stop of stops) {
				// Hidden stations (filtered-out projects) have no box; skip them.
				if (!stop.getClientRects().length) continue;
				const rect = stop.getBoundingClientRect();
				const y = rect.top + Math.min(rect.height / 2, 24);
				const reached = atEnd || y <= line;
				if (reached && settled && !stop.classList.contains('reached')) arrive(stop);
				stop.classList.toggle('reached', reached);
			}
			settled = true;
		};

		const schedule = () => {
			if (queued) return;
			queued = true;
			requestAnimationFrame(update);
		};

		addEventListener('scroll', schedule, { passive: true });
		addEventListener('resize', schedule);
		// Opening a project or timeline entry moves everything below it, and
		// form errors move the terminal row; any change in page height reflows.
		document.addEventListener('toggle', schedule, true);
		if ('ResizeObserver' in window) new ResizeObserver(schedule).observe(document.body);
		// Scroll reveals slide content up by a few pixels; re-measure the
		// terminal once they have settled.
		document.addEventListener('transitionend', schedule, true);
		update();
	}
</script>
