---
---

<button
	id="theme-toggle"
	type="button"
	aria-label="Farbschema wechseln"
	class="ml-1 grid size-8 place-items-center rounded-md border border-[var(--color-border)] text-[var(--color-text-muted)] transition-colors hover:border-[var(--color-accent)] hover:text-[var(--color-accent)]"
>
	<svg
		class="size-4 dark:hidden"
		viewBox="0 0 24 24"
		fill="none"
		stroke="currentColor"
		stroke-width="2"
		stroke-linecap="round"
		aria-hidden="true"
	>
		<circle cx="12" cy="12" r="4"></circle>
		<path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
		></path>
	</svg>
	<svg
		class="hidden size-4 dark:block"
		viewBox="0 0 24 24"
		fill="none"
		stroke="currentColor"
		stroke-width="2"
		stroke-linecap="round"
		stroke-linejoin="round"
		aria-hidden="true"
	>
		<path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
	</svg>
</button>

<script is:inline>
	(function () {
		const button = document.getElementById('theme-toggle');
		const root = document.documentElement;

		function sync() {
			const isDark = root.classList.contains('dark');
			button.setAttribute('aria-pressed', String(isDark));
			button.title = isDark ? 'Zu hellem Design wechseln' : 'Zu dunklem Design wechseln';
		}

		button.addEventListener('click', function () {
			const isDark = root.classList.toggle('dark');
			localStorage.setItem('theme', isDark ? 'dark' : 'light');
			sync();
		});

		sync();
	})();
</script>
