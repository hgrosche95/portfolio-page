---
/**
 * Hero console: one real agent run from ai-trip-planer, replayed line by
 * line. Each log line sends a packet along the matching wire of the small
 * schematic above it, so the movement always carries information. The steps
 * follow that project's actual tool loop; no numbers are invented.
 */
interface Step {
	text: string;
	/** Line colour: user input, outgoing call, incoming result, side note. */
	tone: 'user' | 'out' | 'in' | 'dim';
	/** Wire the packet travels (keys of `wires` below). */
	wire: string;
	/** Replies run the same wire backwards. */
	back?: boolean;
	/** Boxes lit while the line is active. */
	lit: string[];
}

const scenarios: { name: string; steps: Step[] }[] = [
	{
		name: 'Faktenfrage',
		steps: [
			{ text: '› Was isst man in Lissabon?', tone: 'user', wire: 'web-api', lit: ['web', 'api'] },
			{ text: '→ llm.chat(tools = [..., search_travel_knowledge])', tone: 'out', wire: 'api-llm', lit: ['api', 'llm'] },
			{ text: '← tool_call: search_travel_knowledge("Lissabon Essen")', tone: 'in', wire: 'api-llm', back: true, lit: ['llm', 'api'] },
			{ text: '→ rag.search(query, k = 5)', tone: 'out', wire: 'api-rag', lit: ['api', 'rag'] },
			{ text: '→ pgvector: Ähnlichkeitssuche, collection = travel', tone: 'out', wire: 'rag-db', lit: ['rag', 'db'] },
			{ text: '← Treffer mit Quellen', tone: 'in', wire: 'api-rag', back: true, lit: ['rag', 'api'] },
			{ text: '→ llm.chat(Kontext + Quellen)', tone: 'out', wire: 'api-llm', lit: ['api', 'llm'] },
			{ text: '← Antwort mit Quellenangabe', tone: 'in', wire: 'web-api', back: true, lit: ['api', 'web'] },
			{ text: '· trace → Langfuse: Modell, Tokens, Latenz (kein Text)', tone: 'dim', wire: 'api-obs', lit: ['api', 'obs'] },
		],
	},
	{
		name: 'Reiseplan',
		steps: [
			{ text: '› 4 Tage Porto im Mai, mittleres Budget', tone: 'user', wire: 'web-api', lit: ['web', 'api'] },
			{ text: '→ planner: llm.chat(Anfrage) ohne tools', tone: 'out', wire: 'api-llm', lit: ['api', 'llm'] },
			{ text: '← Aufgaben: Wetter, Unterkünfte, Anreise, Wissensbasis', tone: 'in', wire: 'api-llm', back: true, lit: ['llm', 'api'] },
			{ text: '→ research: get_weather · search_lodging · estimate_transport', tone: 'out', wire: 'api-ext', lit: ['api', 'ext'] },
			{ text: '→ research: search_travel_knowledge("Porto")', tone: 'out', wire: 'api-rag', lit: ['api', 'rag'] },
			{ text: '← Recherche fertig (parallel, ohne LLM)', tone: 'in', wire: 'api-ext', back: true, lit: ['ext', 'api'] },
			{ text: '→ planner: llm.chat(Recherche → Tagesplan)', tone: 'out', wire: 'api-llm', lit: ['api', 'llm'] },
			{ text: '← Tagesplan als Entwurf', tone: 'in', wire: 'api-llm', back: true, lit: ['llm', 'api'] },
			{ text: '· budget + critic: Regeln in Code, 0 Tokens', tone: 'dim', wire: 'api-check', lit: ['api'] },
			{ text: '→ planner: llm.chat(Antwort schreiben)', tone: 'out', wire: 'api-llm', lit: ['api', 'llm'] },
			{ text: '← Antwort und Entwurf an den Chat', tone: 'in', wire: 'web-api', back: true, lit: ['api', 'web'] },
			{ text: '· trace → Langfuse (kein Text)', tone: 'dim', wire: 'api-obs', lit: ['api', 'obs'] },
		],
	},
];

/** Boxes, hand-placed in a 520 × 150 drawing. */
const nodes = [
	{ id: 'web', label: 'Next.js', sub: 'Chat', x: 10, y: 22, w: 94, h: 44 },
	{ id: 'api', label: 'NestJS Agent', sub: 'Planer · Kritiker', x: 176, y: 18, w: 120, h: 44 },
	{ id: 'llm', label: 'LLM', sub: 'Groq · Claude', x: 396, y: 2, w: 114, h: 32 },
	{ id: 'obs', label: 'Langfuse', sub: 'ohne Text', x: 396, y: 39, w: 114, h: 32 },
	{ id: 'ext', label: 'Wetter · OSM', sub: 'öffentliche APIs', x: 396, y: 76, w: 114, h: 32 },
	{ id: 'rag', label: 'RAG-Service', sub: 'FastAPI', x: 176, y: 96, w: 120, h: 44 },
	{ id: 'db', label: 'pgvector', sub: 'Neon', x: 396, y: 113, w: 114, h: 32, data: true },
];

/** Wire paths between the boxes, in the direction of the request. */
const wires = {
	'web-api': 'M104 44 H176',
	'api-llm': 'M296 28 H340 V18 H396',
	'api-obs': 'M296 40 H330 V55 H396',
	'api-ext': 'M296 58 H372 V92 H396',
	'api-rag': 'M236 62 V96',
	'rag-db': 'M296 118 H340 V129 H396',
	'api-check': 'M196 18 V8 H276 V18',
};

/*
 * The same circuit, rearranged for narrow consoles (phones, and the hero
 * column on mid-size screens): two columns in a 300 x 230 drawing, so the
 * labels render at ~12px instead of being scaled down to ~6px. Same node and
 * wire ids, so the script animates whichever drawing is visible.
 */
const tallNodes = [
	{ id: 'web', x: 8, y: 14 },
	{ id: 'api', x: 168, y: 14 },
	{ id: 'llm', x: 8, y: 70 },
	{ id: 'rag', x: 168, y: 70 },
	{ id: 'obs', x: 8, y: 126 },
	{ id: 'db', x: 168, y: 126 },
	{ id: 'ext', x: 8, y: 182 },
].map((place) => ({ ...nodes.find((node) => node.id === place.id)!, ...place, w: 124, h: 40 }));

const tallWires = {
	'web-api': 'M132 34 H168',
	'api-llm': 'M176 54 V58 H142 V90 H132',
	'api-obs': 'M182 54 V62 H150 V146 H132',
	'api-ext': 'M188 54 V66 H158 V202 H132',
	'api-rag': 'M230 54 V70',
	'rag-db': 'M230 110 V126',
	'api-check': 'M188 14 V6 H272 V14',
};

const drawings = [
	{ variant: 'wide', viewBox: '0 0 520 150', nodes, wires },
	{ variant: 'tall', viewBox: '0 0 300 230', nodes: tallNodes, wires: tallWires },
];
---

<div class="console" data-agent-console>
	<div class="bar">
		<span>ai-trip-planer · agent.run()</span>
		<span class="replay">Aufzeichnung</span>
	</div>
	<div class="diagram">
		{
			drawings.map((drawing) => (
				<svg class={drawing.variant} viewBox={drawing.viewBox} aria-hidden="true" data-drawing>
					{Object.entries(drawing.wires).map(([id, d]) => <path class="wire" data-wire={id} d={d} />)}
					{drawing.nodes.map((node) => (
						<g class:list={['node', { data: node.data }]} data-node={node.id}>
							<rect x={node.x} y={node.y} width={node.w} height={node.h} rx="6" />
							<text x={node.x + 10} y={node.y + node.h / 2 - 3}>{node.label}</text>
							<text class="sub" x={node.x + 10} y={node.y + node.h / 2 + 11}>{node.sub}</text>
						</g>
					))}
					<circle class="packet" data-packet r="4" cx="-20" cy="-20" />
					<path data-probe d="M0 0" fill="none" stroke="none" />
				</svg>
			))
		}
	</div>
	{/* Without JS this is simply the first run as a list; the script takes it over and types it out. */}
	<ol class="log" data-log>
		{scenarios[0].steps.map((step) => <li class={step.tone}>{step.text}</li>)}
	</ol>
	<div class="foot" data-controls hidden>
		{
			scenarios.map((scenario, i) => (
				<button type="button" data-play={i} aria-pressed={i === 0 ? 'true' : 'false'}>
					{scenario.name}
				</button>
			))
		}
	</div>
	<script is:inline type="application/json" data-scenarios set:html={JSON.stringify(scenarios)} />
</div>

<script is:inline>
	(function () {
		const box = document.querySelector('[data-agent-console]');
		if (!box || box.dataset.ready) return;
		box.dataset.ready = 'true';

		const scenarios = JSON.parse(box.querySelector('[data-scenarios]').textContent);
		const log = box.querySelector('[data-log]');
		// Two drawings of the same circuit (wide and tall); only one is displayed.
		// Each has its own packet and probe; the visible one is looked up per
		// step, so resizing mid-run simply continues in the other drawing.
		const drawings = Array.from(box.querySelectorAll('[data-drawing]'));
		const shown = () => drawings.find((svg) => svg.getClientRects().length) || drawings[0];
		const resetPackets = () => box.querySelectorAll('[data-packet]').forEach((p) => p.setAttribute('cx', '-20'));
		const buttons = box.querySelectorAll('[data-play]');
		const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		const sleep = (ms) => new Promise((resolve) => setTimeout(resolve, ms));

		// Every play() bumps `run`; an older loop notices it is outdated and
		// stops, so switching scenarios never leaves two runs typing at once.
		let run = 0;
		let visible = true;

		function light(ids, wire) {
			box.querySelectorAll('[data-node]').forEach((n) => n.classList.toggle('on', ids.includes(n.dataset.node)));
			box.querySelectorAll('[data-wire]').forEach((w) => w.classList.toggle('on', w.dataset.wire === wire));
		}

		async function typeLine(li, text, token) {
			const caret = document.createElement('span');
			caret.className = 'caret';
			for (let i = 0; i <= text.length; i += 2) {
				if (token !== run) return false;
				li.textContent = text.slice(0, i);
				li.appendChild(caret);
				await sleep(14);
			}
			li.textContent = text;
			return true;
		}

		function travel(step, token) {
			const svg = shown();
			const packet = svg.querySelector('[data-packet]');
			const probe = svg.querySelector('[data-probe]');
			resetPackets();
			probe.setAttribute('d', svg.querySelector(`[data-wire="${step.wire}"]`).getAttribute('d'));
			const length = probe.getTotalLength();
			const duration = Math.max(420, length * 3.4);
			const start = performance.now();
			return new Promise((resolve) => {
				(function frame(now) {
					if (token !== run) return resolve(false);
					const t = Math.min(1, (now - start) / duration);
					const eased = t < 0.5 ? 2 * t * t : 1 - Math.pow(-2 * t + 2, 2) / 2;
					const point = probe.getPointAtLength(length * (step.back ? 1 - eased : eased));
					packet.setAttribute('cx', point.x);
					packet.setAttribute('cy', point.y);
					if (t < 1) requestAnimationFrame(frame);
					else resolve(true);
				})(start);
			});
		}

		async function play(index) {
			run += 1;
			const token = run;
			buttons.forEach((b, i) => b.setAttribute('aria-pressed', String(i === index)));
			const steps = scenarios[index].steps;
			log.textContent = '';

			if (reduceMotion) {
				// The whole run at once, so the log takes the height it needs
				// instead of the fixed window the typing animation scrolls through.
				log.style.height = 'auto';
				for (const step of steps) {
					const li = document.createElement('li');
					li.className = step.tone;
					li.textContent = step.text;
					log.appendChild(li);
				}
				return;
			}

			while (token === run) {
				for (const step of steps) {
					// Pause while scrolled out of view.
					while (!visible && token === run) await sleep(300);
					if (token !== run) return;
					const li = document.createElement('li');
					li.className = step.tone;
					log.appendChild(li);
					// Keep the newest lines in view: drop the oldest once the log is full.
					while (log.scrollHeight > log.clientHeight && log.firstChild !== li) log.firstChild.remove();
					light(step.lit, step.wire);
					if (!(await typeLine(li, step.text, token))) return;
					if (!(await travel(step, token))) return;
					await sleep(260);
				}
				await sleep(2600);
				if (token !== run) return;
				log.textContent = '';
				light([], '');
				resetPackets();
			}
		}

		if ('IntersectionObserver' in window) {
			new IntersectionObserver((entries) => {
				visible = entries[0].isIntersecting;
			}).observe(box);
		}

		// The typed copy is decoration; the figcaption next to it says what it shows.
		log.setAttribute('aria-hidden', 'true');
		box.querySelector('[data-controls]').hidden = false;
		buttons.forEach((b, i) => b.addEventListener('click', () => play(i)));

		// If an intro animation is running (html[data-hero-booting]), start once
		// it reports "hero:booted"; otherwise start right away.
		const startConsole = () => play(0);
		if (document.documentElement.hasAttribute('data-hero-booting')) {
			document.addEventListener('hero:booted', startConsole, { once: true });
		} else {
			startConsole();
		}
	})();
</script>

<style>
	.console {
		overflow: hidden;
		border: 1px solid var(--color-border-strong);
		border-radius: 0.75rem;
		background-color: var(--color-surface);
	}

	.bar {
		display: flex;
		justify-content: space-between;
		gap: 0.75rem;
		border-bottom: 1px dashed var(--color-border-strong);
		padding: 0.6rem 0.875rem;
		font: 12px var(--font-mono);
		color: var(--color-text-muted);
	}

	.replay {
		color: var(--color-text-muted);
	}

	.console {
		container-type: inline-size;
	}

	.diagram {
		border-bottom: 1px dashed var(--color-border-strong);
	}

	svg {
		display: block;
		width: 100%;
		height: auto;
	}

	/* Below ~440px the wide drawing would scale its labels under ~9px. */
	svg.tall {
		display: none;
		max-width: 26rem;
		margin-inline: auto;
	}

	@container (max-width: 439px) {
		svg.wide {
			display: none;
		}

		svg.tall {
			display: block;
		}
	}

	.node rect {
		fill: var(--color-bg);
		stroke: var(--color-border-strong);
		transition: stroke 0.25s;
	}

	.node.data rect {
		fill: var(--color-accent-soft);
		stroke: var(--color-accent);
	}

	.node.on rect {
		fill: var(--color-accent-soft);
		stroke: var(--color-accent);
	}

	.node text {
		font: 11px var(--font-mono);
		fill: var(--color-text);
	}

	.node text.sub {
		font-size: 10px;
		fill: var(--color-text-muted);
	}

	.wire {
		fill: none;
		stroke: var(--color-border-strong);
		stroke-width: 1.4;
		transition: stroke 0.25s;
	}

	.wire.on {
		stroke: var(--color-accent);
		stroke-width: 1.8;
	}

	.packet {
		fill: var(--color-accent);
	}

	/* Without JS the first run is a plain list: show all of it. The script sets
	   aria-hidden when it takes over and types into this fixed window. */
	.log:not([aria-hidden]) {
		height: auto !important;
	}

	.log {
		height: 12.75rem;
		margin: 0;
		padding: 0.75rem 0.875rem;
		overflow: hidden;
		list-style: none;
		font: 12.5px/1.65 var(--font-mono);
		color: var(--color-text-muted);
	}

	/*
	 * :global because the script creates these lines: elements made at
	 * runtime carry no Astro scope attribute, so scoped selectors would miss.
	 */
	.log :global(li) {
		white-space: pre-wrap;
		overflow-wrap: anywhere;
	}

	.log :global(li.user) {
		color: var(--color-text);
	}

	.log :global(li.out) {
		color: var(--color-accent);
	}

	.log :global(li.in) {
		color: var(--color-live);
	}

	.log :global(.caret) {
		display: inline-block;
		width: 7px;
		height: 14px;
		margin-left: 1px;
		vertical-align: -2px;
		background-color: var(--color-accent);
		animation: agent-caret-blink 1s steps(1) infinite;
	}

	@keyframes agent-caret-blink {
		50% {
			opacity: 0;
		}
	}

	.foot {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		border-top: 1px dashed var(--color-border-strong);
		padding: 0.6rem 0.875rem;
	}

	.foot button {
		position: relative;
		border: 1px solid var(--color-border-strong);
		border-radius: 0.3rem;
		padding: 0.3rem 0.65rem;
		font: 500 12px var(--font-mono);
		color: var(--color-text-muted);
		cursor: pointer;
	}

	/* Small in the console footer, but a 44px tall hit area. */
	.foot button::after {
		content: '';
		position: absolute;
		inset: -10px -3px;
	}

	.foot button[aria-pressed='true'] {
		border-color: var(--color-accent);
		background-color: var(--color-accent-soft);
		color: var(--color-accent);
	}

	@media (prefers-reduced-motion: reduce) {
		.node rect,
		.wire {
			transition: none;
		}

		.log :global(.caret) {
			animation: none;
		}
	}
</style>