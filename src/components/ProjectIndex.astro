---
import type { CollectionEntry } from 'astro:content';
import Schematic from './Schematic.astro';
import githubStats from '../data/github-stats.json';
import evalStats from '../data/eval-stats.json';
import { kindLabels } from '../lib/project-kinds';
import { versioned } from '../lib/versioned';

interface Props {
	projects: CollectionEntry<'projects'>[];
}

const { projects } = Astro.props;

type RepoStats = { stars: number; language: string | null; lastPushedAt: string };
const stats = githubStats as Record<string, RepoStats | undefined>;

type Metrics = NonNullable<CollectionEntry<'projects'>['data']['metrics']>;
// Results of the latest nightly eval run, fetched at build time
// (scripts/fetch-eval-stats.ts); they replace the static fallback in the content file.
const liveMetrics = evalStats as Record<string, Metrics | undefined>;

const formatDate = (iso: string) => new Date(iso).toLocaleDateString('de-DE', { month: '2-digit', year: 'numeric' });

/** How long the hover preview loops, from its start chapter (seconds). */
const PEEK_LOOP = 8;

/**
 * What a row can show of the running app: the demo recording (its poster,
 * or `preview` if set, as the still; a short muted loop from the second
 * chapter on hover) or, without a recording, the `preview` still alone. Rows with neither show nothing rather than a
 * placeholder.
 */
const peekFor = (data: CollectionEntry<'projects'>['data']) => {
	if (data.demo) {
		const d = data.demo;
		return {
			// A real screenshot beats the clip's poster when the poster is a title card.
			still: data.preview ?? versioned(d.poster),
			mp4: versioned(d.src),
			webm: versioned(d.src.replace(/\.mp4$/, '.webm')),
			start: d.chapters[1]?.t ?? 0,
			format: d.format,
			width: d.width,
			height: d.height,
		};
	}
	if (data.preview) return { still: data.preview, format: 'desktop' as const, width: 16, height: 10 };
	return null;
};

/** Longer stacks are cut off with a "+n" counter so the rows stay one height; the full list is on the project page. */
const MAX_TAGS = 4;
---

<div class="index">
	{/* The top rule is its own element so it fades in with the rows instead of
	    standing there alone before them. */}
	<div class="index-rule" data-reveal aria-hidden="true"></div>
	{
		projects.map((entry, i) => {
			const { data } = entry;
			const repo = stats[data.githubRepo];
			const extraTags = data.techStack.length - MAX_TAGS;
			const decision = data.decisions?.[0];
			const metrics = liveMetrics[entry.id] ?? data.metrics;
			const peek = peekFor(data);
			return (
				<article class="row trace-station" data-project-kind={data.kind} data-trace-stop data-reveal>
					{/* The head is plain content, not part of the toggle: its links
					    (title → project page, live button → demo) must stay real links,
					    and interactive elements inside a <summary> would swallow the
					    click and read badly to screen readers. */}
					<div class="head">
						<span class="kind">{kindLabels[data.kind]}</span>
						<span class="main">
							{/* The live button sits right beside the title, so "you can try
							    this" is the first thing seen, not a footnote in the label column. */}
							<span class="title-row">
								<h3 style={`view-transition-name: project-${entry.id}`}>
									<a href={`/projects/${entry.id}`}>{data.title}</a>
								</h3>
								{/* Only something to try gets the live button; a technical
								    endpoint stays a plain link in the details below. */}
								{data.liveUrl && data.liveKind === 'demo' && (
									<a class="live-link" href={data.liveUrl} target="_blank" rel="noopener noreferrer">
										{data.liveLabel ?? 'Live ansehen'}
										<span class="sr-only"> (öffnet in neuem Tab)</span>
									</a>
								)}
							</span>
							{/* A look at the running app: a fixed thumbnail on small screens,
							    a floating preview on hover from 961px (a short muted loop of the
							    demo recording when there is one). Decorative: the title, summary
							    and the reel below say the same in words. */}
							{peek && (
								<span class="peek" data-format={peek.format} aria-hidden="true">
									<img src={peek.still} alt="" width={peek.width} height={peek.height} loading="lazy" decoding="async" />
									{peek.mp4 && (
										<video
											muted
											playsinline
											preload="none"
											tabindex="-1"
											data-peek-video
											data-start={peek.start}
											data-loop={PEEK_LOOP}
										>
											<source src={peek.webm} type="video/webm" />
											<source src={peek.mp4} type="video/mp4" />
										</video>
									)}
								</span>
							)}
							<span class="summary">{data.summary}</span>
							{/* Measured results, visible even with the row closed: the
							    evidence behind the hero's "measurable agents". */}
							{metrics && (
								<span class="metrics">
									<span class="metric-list" role="list">
										{metrics.items.map((m) => (
											<span class="metric" role="listitem" style={`--len: ${m.value.length}`}>
												<span class="value">
													{/* The visible figure counts up (script below); readers get the final value. */}
													<span aria-hidden="true" data-count={m.value}>{m.value}</span>
													<span class="sr-only">{m.value}</span>
												</span>
												<span class="mlabel">{m.label}</span>
											</span>
										))}
									</span>
									<a class="metric-source" href={metrics.source.url} target="_blank" rel="noopener noreferrer">
										{metrics.source.label}
										<span class="sr-only"> (öffnet in neuem Tab)</span>
									</a>
								</span>
							)}
						</span>
						<span class="facts">
							<span class="stack">
								{data.techStack.slice(0, MAX_TAGS).join(', ')}
								{extraTags > 0 && ` +${extraTags}`}
							</span>
							{repo && <span>{[repo.language, `zuletzt ${formatDate(repo.lastPushedAt)}`].filter(Boolean).join(' · ')}</span>}
						</span>
					</div>

					{/* Only the "+" toggles; still <details>, so it opens without JS. */}
					<details open={i === 0}>
						<summary>
							<span class="toggle" aria-hidden="true">
								+
							</span>
							<span class="sr-only">Schaltplan und Details zu {data.title}</span>
						</summary>

					<div class="detail">
						{/* Only the first scenario, played once when the row comes into view
						    (Schematic `once`): the route draws itself and stays lit. Looping
						    animations in every row would be noise; the project page has all
						    scenarios with controls. */}
						{data.architecture?.lanes && (
							<Schematic
								architecture={{ ...data.architecture, scenarios: data.architecture.scenarios?.slice(0, 1) ?? [] }}
								compact
								once
							/>
						)}
						<div class="aside">
							{decision && (
								<p class="decision">
									<span class="label">Entscheidung: {decision.topic}</span>
									{decision.rejected.length > 0 && (
										<>
											<s>{decision.rejected.join(' / ')}</s>
											<span class="sr-only">(verworfen), stattdessen:</span>
											<span aria-hidden="true"> → </span>
										</>
									)}
									<strong>{decision.chosen}</strong>
								</p>
							)}
							{data.hosting && <p class="hosting">{data.hosting}</p>}
							<p class="links">
								<a href={`/projects/${entry.id}`}>Projekt lesen</a>
								{data.liveUrl && (
									<a href={data.liveUrl} target="_blank" rel="noopener noreferrer">
										{data.liveLabel ?? 'Live ansehen'}<span class="sr-only"> (öffnet in neuem Tab)</span>
									</a>
								)}
								<a href={`https://github.com/hgrosche95/${data.githubRepo}`} target="_blank" rel="noopener noreferrer">
									Code<span class="sr-only"> (öffnet in neuem Tab)</span>
								</a>
							</p>
						</div>
					</div>
					</details>
				</article>
			);
		})
	}
</div>

<script is:inline>
	(function () {
		// Metrics count up from zero once when they scroll into view: every
		// number inside a value ("310", "0,95 / 0,67", "3,6 s / 1,1 s") counts
		// to itself, keeping its decimals and the text around it. What is
		// already on screen at load stays as it is (no flicker), and with
		// reduced motion nothing moves.
		if (window.matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) return;
		const NUMBER = /\d+(?:,\d+)?/g;
		const DURATION = 700;
		const format = function (value, decimals) {
			return value.toFixed(decimals).replace('.', ',');
		};
		const groups = Array.prototype.slice.call(document.querySelectorAll('.index .metric-list'));
		const observer = new IntersectionObserver(
			function (entries) {
				entries.forEach(function (entry) {
					if (!entry.isIntersecting) return;
					observer.unobserve(entry.target);
					const figures = Array.prototype.slice.call(entry.target.querySelectorAll('[data-count]'));
					const start = performance.now();
					(function frame(now) {
						const t = Math.min(1, (now - start) / DURATION);
						const eased = 1 - Math.pow(1 - t, 3);
						figures.forEach(function (el) {
							el.textContent = el.dataset.count.replace(NUMBER, function (match) {
								const decimals = (match.split(',')[1] || '').length;
								return format(parseFloat(match.replace(',', '.')) * eased, decimals);
							});
						});
						if (t < 1) requestAnimationFrame(frame);
					})(start);
				});
			},
			{ threshold: 0.6 },
		);
		groups.forEach(function (group) {
			const rect = group.getBoundingClientRect();
			// Already visible (or inside a closed row, no box yet): leave it alone
			// unless it is below the fold, where it can count up on arrival.
			if (!rect.height || rect.top < window.innerHeight) return;
			group.querySelectorAll('[data-count]').forEach(function (el) {
				el.textContent = el.dataset.count.replace(NUMBER, function (match) {
					return format(0, (match.split(',')[1] || '').length);
				});
			});
			observer.observe(group);
		});
	})();

	(function () {
		// Hover preview: the row's demo clip plays muted from its start chapter
		// in a short loop while the pointer is on the row, and pauses when it
		// leaves. Nothing loads until the first hover (preload="none"). Only for
		// a real hover pointer, with motion allowed and where the floating
		// preview is shown at all; otherwise the still image is all there is.
		const canPeek = window.matchMedia('(hover: hover) and (pointer: fine) and (min-width: 961px)');
		if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
		document.querySelectorAll('.index .row').forEach(function (row) {
			const video = row.querySelector('[data-peek-video]');
			if (!video) return;
			const start = parseFloat(video.dataset.start) || 0;
			const loop = parseFloat(video.dataset.loop) || 8;
			let primed = false;
			function play() {
				const playing = video.play();
				if (playing) playing.catch(function () {});
			}
			row.addEventListener('pointerenter', function () {
				if (!canPeek.matches) return;
				if (primed) {
					play();
					return;
				}
				primed = true;
				video.addEventListener('loadedmetadata', function () {
					video.currentTime = start;
					if (row.matches(':hover')) play();
				}, { once: true });
				video.addEventListener('playing', function () {
					row.classList.add('peek-live');
				});
				video.load();
			});
			row.addEventListener('pointerleave', function () {
				video.pause();
			});
			video.addEventListener('timeupdate', function () {
				if (video.currentTime >= start + loop || video.currentTime < start - 0.5) video.currentTime = start;
			});
		});
	})();

	(function () {
		// A click anywhere on a row's head opens or closes its details, like the
		// "+" does. Links inside (title, live button) keep navigating, and without
		// JS the "+" alone still works because it is a real <details>.
		document.querySelectorAll('.index .row').forEach(function (row) {
			const head = row.querySelector('.head');
			const details = row.querySelector('details');
			head.addEventListener('click', function (event) {
				if (event.target.closest('a, .metrics')) return;
				// Selecting text to copy it should not toggle the row.
				if (window.getSelection().toString()) return;
				details.open = !details.open;
			});
		});
	})();
</script>

<style>
	.index {
		margin-top: 1.5rem;
	}

	.index-rule {
		border-top: 1px solid var(--color-text);
	}

	.row {
		/* Height of the row's first line, where the branch to the trace joins. */
		--station-y: calc(1.25rem + var(--text-project) * 0.55);
		position: relative;
		border-bottom: 1px solid var(--color-border);
	}

	/* Each row is a station on the homepage trace: see .trace-station in global.css. */

	/* The fourth column stays empty: the toggle sits on top of it. */
	.head {
		display: grid;
		grid-template-columns: 8.5rem minmax(0, 1fr) 13rem 1.5rem;
		gap: 1.5rem;
		align-items: baseline;
		padding: 1.25rem 0;
		cursor: pointer;
	}

	/* The whole head acts as the toggle, so hovering it lights the "+". */
	.row:has(.head:hover) .toggle {
		color: var(--color-accent);
	}

	/*
	 * The "+" toggle, pinned to the head's top-right corner. Absolutely
	 * positioned so the closed <details> takes no height of its own and the
	 * opened panel still flows directly under the head.
	 */
	summary {
		position: absolute;
		top: calc(var(--station-y) - 1.375rem);
		right: -0.375rem;
		display: grid;
		place-items: center;
		/* 44px: a comfortable touch target. */
		width: 2.75rem;
		height: 2.75rem;
		border-radius: 0.375rem;
		cursor: pointer;
		list-style: none;
	}

	summary::-webkit-details-marker {
		display: none;
	}

	summary:hover .toggle {
		color: var(--color-accent);
	}

	summary:focus-visible {
		outline: 2px solid var(--color-accent);
		outline-offset: 2px;
	}

	.kind {
		display: grid;
		gap: 0.3rem;
		font: 0.75rem/1.35 var(--font-mono);
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--color-text-muted);
	}

	.title-row {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem 1rem;
	}

	.main {
		display: grid;
		gap: 0.4rem;
	}

	h3 {
		margin: 0;
		font-family: var(--font-display);
		font-size: var(--text-project);
		font-weight: 600;
		line-height: 1.1;
		letter-spacing: -0.02em;
		color: var(--color-text);
		transition: color 0.2s;
	}

	h3 a {
		display: inline-block;
		padding-block: 0.6rem;
		margin-block: -0.6rem;
		color: inherit;
		text-decoration: none;
		text-decoration-thickness: 2px;
		text-underline-offset: 5px;
	}

	h3 a:hover {
		color: var(--color-accent);
		text-decoration: underline;
	}

	.summary {
		max-width: 62ch;
		font-size: var(--text-body);
		line-height: 1.55;
		color: var(--color-text-muted);
	}

	.metrics {
		display: grid;
		gap: 0.25rem;
		margin-top: 0.5rem;
		cursor: auto;
	}

	.metric-list {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(11rem, 1fr));
		gap: 1.25rem 1.75rem;
		padding: 1rem 0 1rem 1.1rem;
		border-left: 2px solid var(--accent);
	}

	/* Each figure sizes itself against its own cell (container query units),
	   so a long value ("3,6 s / 1,1 s") shrinks to fit instead of overflowing,
	   while a short one ("12") reaches the full 64px. */
	.metric {
		display: grid;
		align-content: start;
		gap: 0.35rem;
		container-type: inline-size;
	}

	.metric .value {
		font-family: var(--font-display);
		font-size: clamp(1.5rem, min(4rem, calc(100cqi / (var(--len, 4) * 0.56))), 4rem);
		font-weight: 700;
		line-height: 1;
		letter-spacing: -0.03em;
		font-variant-numeric: tabular-nums;
		white-space: nowrap;
		color: var(--ink);
	}

	.metric .mlabel {
		max-width: 26ch;
		font-size: var(--text-small);
		line-height: 1.4;
		color: var(--muted);
	}

	.metric-source {
		display: inline-flex;
		align-items: center;
		justify-self: start;
		min-height: 2.75rem;
		font: 0.8125rem var(--font-mono);
		color: var(--accent);
		text-decoration: underline;
		text-decoration-color: color-mix(in srgb, var(--accent) 35%, transparent);
		text-underline-offset: 3px;
	}

	.metric-source:hover {
		text-decoration-color: var(--accent);
	}

	.facts {
		display: grid;
		gap: 0.25rem;
		font: 0.75rem/1.5 var(--font-mono);
		color: var(--color-text-muted);
		font-variant-numeric: tabular-nums;
	}

	.stack {
		color: var(--color-text);
	}

	.toggle {
		font: 1.1rem var(--font-mono);
		color: var(--color-text-muted);
		transition:
			transform 0.25s,
			color 0.2s;
	}

	details[open] .toggle {
		transform: rotate(45deg);
		color: var(--color-accent);
	}

	.detail {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 15rem;
		gap: 1.5rem;
		padding: 0 0 1.75rem 10rem;
	}

	.aside {
		display: grid;
		align-content: start;
		gap: 0.9rem;
		font-size: var(--text-small);
		line-height: 1.5;
	}

	.aside p {
		margin: 0;
	}

	.decision {
		border-left: 2px solid var(--color-accent);
		padding-left: 0.75rem;
		color: var(--color-text-muted);
	}

	.decision .label {
		display: block;
		margin-bottom: 0.2rem;
		font: 600 0.8125rem var(--font-sans);
		color: var(--color-accent);
	}

	.decision strong {
		font-weight: 600;
		color: var(--color-text);
	}

	.hosting {
		font: 0.75rem var(--font-mono);
		color: var(--color-text-muted);
	}

	.links {
		display: flex;
		flex-wrap: wrap;
		gap: 0 1.25rem;
		font: 500 1rem var(--font-sans);
	}

	/* 44px tall hit areas; the underline stays at the text. */
	.links a {
		display: inline-flex;
		align-items: center;
		min-width: 2.75rem;
		min-height: 2.75rem;
		color: var(--color-accent);
		text-decoration: underline;
		text-decoration-color: color-mix(in srgb, var(--color-accent) 35%, transparent);
		text-underline-offset: 3px;
	}

	.links a:hover {
		text-decoration-color: var(--color-accent);
	}

	/*
	 * The preview. Small screens: a fixed thumbnail under the title. From
	 * 961px with a hover pointer: hidden until the row is hovered, then it
	 * floats over the right-hand facts column, tilted forward like the hero
	 * console, with the clip playing in it.
	 */
	.peek {
		position: relative;
		display: block;
		overflow: hidden;
		margin: 0.35rem 0 0.2rem;
		aspect-ratio: 16 / 9;
		border: 1px solid var(--color-border-strong);
		border-radius: var(--radius-frame);
		background-color: var(--color-surface-raised);
	}

	.peek img,
	.peek video {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: top;
	}

	/* Phone recordings: whole screen, centred, rather than a cropped strip. */
	.peek[data-format='mobile'] img,
	.peek[data-format='mobile'] video {
		object-fit: contain;
	}

	.peek video {
		opacity: 0;
		transition: opacity 0.3s;
	}

	.peek-live .peek video {
		opacity: 1;
	}

	@media (min-width: 961px) {
		.peek {
			position: absolute;
			z-index: 3;
			top: 1rem;
			right: 3rem;
			width: clamp(16rem, 21vw, 26rem);
			margin: 0;
			aspect-ratio: 16 / 10;
			pointer-events: none;
			opacity: 0;
			visibility: hidden;
			transform: perspective(1200px) rotateY(-8deg) translateY(6px) scale(0.96);
			transform-origin: right center;
			box-shadow:
				0 30px 60px -30px rgb(0 0 0 / 0.7),
				0 0 0 1px color-mix(in srgb, var(--accent) 25%, transparent);
			transition:
				opacity 0.25s,
				visibility 0s 0.25s,
				transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
		}

		.peek[data-format='mobile'] {
			width: clamp(10rem, 12vw, 12rem);
			aspect-ratio: 9 / 16;
		}

		/* Without a hover pointer (touch laptops, pens) it never floats in. */
		@media (hover: hover) and (pointer: fine) {
			.row:hover .peek {
				opacity: 1;
				visibility: visible;
				transform: perspective(1200px) rotateY(-8deg);
				transition:
					opacity 0.25s,
					visibility 0s,
					transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
			}
		}

	}

	@media (prefers-reduced-motion: reduce) {
		.peek,
		.peek video,
		.row:hover .peek {
			transition: none;
		}

		.peek,
		.row:hover .peek {
			transform: none;
		}

		.peek video {
			display: none;
		}
	}

	@media (max-width: 960px) {
		/* The kind label now sits above the title: the branch meets the label. */
		.row {
			--station-y: calc(1.25rem + 8px);
		}

		.head {
			grid-template-columns: minmax(0, 1fr) 1.5rem;
			gap: 0.6rem;
		}

		.kind {
			grid-column: 1;
			display: flex;
			flex-wrap: wrap;
			gap: 0.25rem 1rem;
		}

		.main,
		.facts {
			grid-column: 1;
		}

		/* Picture first: the row reads like a card, and the first app shot
		   lands within the first two screens on a phone. */
		.peek {
			order: -1;
			margin: 0.2rem 0 0.3rem;
		}

		.detail {
			grid-template-columns: minmax(0, 1fr);
			padding-left: 0;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.toggle,
		h3 {
			transition: none;
		}
