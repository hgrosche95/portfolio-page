---
import type { CollectionEntry } from 'astro:content';
import Schematic from './Schematic.astro';
import githubStats from '../data/github-stats.json';
import evalStats from '../data/eval-stats.json';
import { kindLabels } from '../lib/project-kinds';

interface Props {
	projects: CollectionEntry<'projects'>[];
}

const { projects } = Astro.props;

type RepoStats = { stars: number; language: string | null; lastPushedAt: string };
const stats = githubStats as Record<string, RepoStats | undefined>;

type Metrics = NonNullable<CollectionEntry<'projects'>['data']['metrics']>;
// Results of the latest nightly eval run, fetched at build time
// (scripts/fetch-eval-stats.ts); they replace the static fallback in the content file.
const liveMetrics = evalStats as Record<string, Metrics | undefined>;

const formatDate = (iso: string) => new Date(iso).toLocaleDateString('de-DE', { month: '2-digit', year: 'numeric' });

/** Longer stacks are cut off with a "+n" counter so the rows stay one height; the full list is on the project page. */
const MAX_TAGS = 4;
---

<div class="index">
	{/* The top rule is its own element so it fades in with the rows instead of
	    standing there alone before them. */}
	<div class="index-rule" data-reveal aria-hidden="true"></div>
	{
		projects.map((entry, i) => {
			const { data } = entry;
			const repo = stats[data.githubRepo];
			const extraTags = data.techStack.length - MAX_TAGS;
			const decision = data.decisions?.[0];
			const metrics = liveMetrics[entry.id] ?? data.metrics;
			return (
				<article class="row trace-station" data-project-kind={data.kind} data-trace-stop data-reveal>
					{/* The head is plain content, not part of the toggle: its links
					    (title → project page, live button → demo) must stay real links,
					    and interactive elements inside a <summary> would swallow the
					    click and read badly to screen readers. */}
					<div class="head">
						<span class="kind">{kindLabels[data.kind]}</span>
						<span class="main">
							{/* The live button sits right beside the title, so "you can try
							    this" is the first thing seen, not a footnote in the label column. */}
							<span class="title-row">
								<h3 style={`view-transition-name: project-${entry.id}`}>
									<a href={`/projects/${entry.id}`}>{data.title}</a>
								</h3>
								{/* Only something to try gets the live button; a technical
								    endpoint stays a plain link in the details below. */}
								{data.liveUrl && data.liveKind === 'demo' && (
									<a class="live-link" href={data.liveUrl} target="_blank" rel="noopener noreferrer">
										{data.liveLabel ?? 'Live ansehen'}
										<span class="sr-only"> (öffnet in neuem Tab)</span>
									</a>
								)}
							</span>
							<span class="summary">{data.summary}</span>
							{/* Measured results, visible even with the row closed: the
							    evidence behind the hero's "measurable agents". */}
							{metrics && (
								<span class="metrics">
									<span class="metric-list" role="list">
										{metrics.items.map((m) => (
											<span class="metric" role="listitem">
												<span class="value">{m.value}</span>
												<span class="mlabel">{m.label}</span>
											</span>
										))}
									</span>
									<a class="metric-source" href={metrics.source.url} target="_blank" rel="noopener noreferrer">
										{metrics.source.label}
										<span class="sr-only"> (öffnet in neuem Tab)</span>
									</a>
								</span>
							)}
						</span>
						<span class="facts">
							<span class="stack">
								{data.techStack.slice(0, MAX_TAGS).join(', ')}
								{extraTags > 0 && ` +${extraTags}`}
							</span>
							{repo && <span>{[repo.language, `zuletzt ${formatDate(repo.lastPushedAt)}`].filter(Boolean).join(' · ')}</span>}
						</span>
					</div>

					{/* Only the "+" toggles; still <details>, so it opens without JS. */}
					<details open={i === 0}>
						<summary>
							<span class="toggle" aria-hidden="true">
								+
							</span>
							<span class="sr-only">Schaltplan und Details zu {data.title}</span>
						</summary>

					<div class="detail">
						{/* Only the first scenario, played once when the row comes into view
						    (Schematic `once`): the route draws itself and stays lit. Looping
						    animations in every row would be noise; the project page has all
						    scenarios with controls. */}
						{data.architecture?.lanes && (
							<Schematic
								architecture={{ ...data.architecture, scenarios: data.architecture.scenarios?.slice(0, 1) ?? [] }}
								compact
								once
							/>
						)}
						<div class="aside">
							{decision && (
								<p class="decision">
									<span class="label">Entscheidung: {decision.topic}</span>
									{decision.rejected.length > 0 && (
										<>
											<s>{decision.rejected.join(' / ')}</s>
											<span class="sr-only">(verworfen), stattdessen:</span>
											<span aria-hidden="true"> → </span>
										</>
									)}
									<strong>{decision.chosen}</strong>
								</p>
							)}
							{data.hosting && <p class="hosting">{data.hosting}</p>}
							<p class="links">
								<a href={`/projects/${entry.id}`}>Projekt lesen</a>
								{data.liveUrl && (
									<a href={data.liveUrl} target="_blank" rel="noopener noreferrer">
										{data.liveLabel ?? 'Live ansehen'}<span class="sr-only"> (öffnet in neuem Tab)</span>
									</a>
								)}
								<a href={`https://github.com/hgrosche95/${data.githubRepo}`} target="_blank" rel="noopener noreferrer">
									Code<span class="sr-only"> (öffnet in neuem Tab)</span>
								</a>
							</p>
						</div>
					</div>
					</details>
				</article>
			);
		})
	}
</div>

<script is:inline>
	(function () {
		// A click anywhere on a row's head opens or closes its details, like the
		// "+" does. Links inside (title, live button) keep navigating, and without
		// JS the "+" alone still works because it is a real <details>.
		document.querySelectorAll('.index .row').forEach(function (row) {
			const head = row.querySelector('.head');
			const details = row.querySelector('details');
			head.addEventListener('click', function (event) {
				if (event.target.closest('a, .metrics')) return;
				// Selecting text to copy it should not toggle the row.
				if (window.getSelection().toString()) return;
				details.open = !details.open;
			});
		});
	})();
</script>

<style>
	.index {
		margin-top: 1.5rem;
	}

	.index-rule {
		border-top: 1px solid var(--color-text);
	}

	.row {
		/* Height of the row's first line, where the branch to the trace joins. */
		--station-y: calc(1.25rem + var(--text-project) * 0.55);
		position: relative;
		border-bottom: 1px solid var(--color-border);
	}

	/* Each row is a station on the homepage trace: see .trace-station in global.css. */

	/* The fourth column stays empty: the toggle sits on top of it. */
	.head {
		display: grid;
		grid-template-columns: 8.5rem minmax(0, 1fr) 13rem 1.5rem;
		gap: 1.5rem;
		align-items: baseline;
		padding: 1.25rem 0;
		cursor: pointer;
	}

	/* The whole head acts as the toggle, so hovering it lights the "+". */
	.row:has(.head:hover) .toggle {
		color: var(--color-accent);
	}

	/*
	 * The "+" toggle, pinned to the head's top-right corner. Absolutely
	 * positioned so the closed <details> takes no height of its own and the
	 * opened panel still flows directly under the head.
	 */
	summary {
		position: absolute;
		top: calc(var(--station-y) - 1.375rem);
		right: -0.375rem;
		display: grid;
		place-items: center;
		/* 44px: a comfortable touch target. */
		width: 2.75rem;
		height: 2.75rem;
		border-radius: 0.375rem;
		cursor: pointer;
		list-style: none;
	}

	summary::-webkit-details-marker {
		display: none;
	}

	summary:hover .toggle {
		color: var(--color-accent);
	}

	summary:focus-visible {
		outline: 2px solid var(--color-accent);
		outline-offset: 2px;
	}

	.kind {
		display: grid;
		gap: 0.3rem;
		font: 12px/1.35 var(--font-mono);
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--color-text-muted);
	}

	.title-row {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem 1rem;
	}

	.main {
		display: grid;
		gap: 0.4rem;
	}

	h3 {
		margin: 0;
		font-family: var(--font-display);
		font-size: var(--text-project);
		font-weight: 600;
		line-height: 1.1;
		letter-spacing: -0.02em;
		color: var(--color-text);
		transition: color 0.2s;
	}

	h3 a {
		color: inherit;
		text-decoration: none;
		text-decoration-thickness: 2px;
		text-underline-offset: 5px;
	}

	h3 a:hover {
		color: var(--color-accent);
		text-decoration: underline;
	}

	.summary {
		max-width: 62ch;
		font-size: 0.925rem;
		line-height: 1.55;
		color: var(--color-text-muted);
	}

	.metrics {
		display: grid;
		gap: 0.25rem;
		margin-top: 0.5rem;
		cursor: auto;
	}

	.metric-list {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(9.5rem, 1fr));
		gap: 0.75rem 1.25rem;
		padding: 0.75rem 0 0.75rem 0.85rem;
		border-left: 2px solid var(--accent);
	}

	.metric {
		display: grid;
		align-content: start;
		gap: 0.15rem;
	}

	.metric .value {
		font: 600 1.05rem/1.2 var(--font-mono);
		font-variant-numeric: tabular-nums;
		color: var(--ink);
	}

	.metric .mlabel {
		font-size: 0.8rem;
		line-height: 1.4;
		color: var(--muted);
	}

	.metric-source {
		display: inline-flex;
		align-items: center;
		justify-self: start;
		min-height: 2.75rem;
		font: 12.5px var(--font-mono);
		color: var(--accent);
		text-decoration: underline;
		text-decoration-color: color-mix(in srgb, var(--accent) 35%, transparent);
		text-underline-offset: 3px;
	}

	.metric-source:hover {
		text-decoration-color: var(--accent);
	}

	.facts {
		display: grid;
		gap: 0.25rem;
		font: 12px/1.5 var(--font-mono);
		color: var(--color-text-muted);
		font-variant-numeric: tabular-nums;
	}

	.stack {
		color: var(--color-text);
	}

	.toggle {
		font: 1.1rem var(--font-mono);
		color: var(--color-text-muted);
		transition:
			transform 0.25s,
			color 0.2s;
	}

	details[open] .toggle {
		transform: rotate(45deg);
		color: var(--color-accent);
	}

	.detail {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 15rem;
		gap: 1.5rem;
		padding: 0 0 1.75rem 10rem;
	}

	.aside {
		display: grid;
		align-content: start;
		gap: 0.9rem;
		font-size: 0.875rem;
		line-height: 1.5;
	}

	.aside p {
		margin: 0;
	}

	.decision {
		border-left: 2px solid var(--color-accent);
		padding-left: 0.75rem;
		color: var(--color-text-muted);
	}

	.decision .label {
		display: block;
		margin-bottom: 0.2rem;
		font: 600 12.5px var(--font-sans);
		color: var(--color-accent);
	}

	.decision strong {
		font-weight: 600;
		color: var(--color-text);
	}

	.hosting {
		font: 12px var(--font-mono);
		color: var(--color-text-muted);
	}

	.links {
		display: flex;
		flex-wrap: wrap;
		gap: 0 1.25rem;
		font: 500 13.5px var(--font-sans);
	}

	/* 44px tall hit areas; the underline stays at the text. */
	.links a {
		display: inline-flex;
		align-items: center;
		min-width: 2.75rem;
		min-height: 2.75rem;
		color: var(--color-accent);
		text-decoration: underline;
		text-decoration-color: color-mix(in srgb, var(--color-accent) 35%, transparent);
		text-underline-offset: 3px;
	}

	.links a:hover {
		text-decoration-color: var(--color-accent);
	}

	@media (max-width: 960px) {
		/* The kind label now sits above the title: the branch meets the label. */
		.row {
			--station-y: calc(1.25rem + 8px);
		}

		.head {
			grid-template-columns: minmax(0, 1fr) 1.5rem;
			gap: 0.6rem;
		}

		.kind {
			grid-column: 1;
			display: flex;
			flex-wrap: wrap;
			gap: 0.25rem 1rem;
		}

		.main,
		.facts {
			grid-column: 1;
		}

		.detail {
			grid-template-columns: minmax(0, 1fr);
			padding-left: 0;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.toggle,
		h3 {
			transition: none;
		}
	}
</style>
