---
import type { CollectionEntry } from 'astro:content';
import { kindLabels } from '../lib/project-kinds';

/**
 * The projects with a cover screenshot, as picture-first cards above the
 * compact index. What they show is the running app, so a visitor sees real
 * software before reading a single summary; each card carries the project's
 * first decision as its one line of reasoning.
 */
interface Props {
	projects: CollectionEntry<'projects'>[];
}

const { projects } = Astro.props;
---

<div class="featured" data-xray="FeaturedProjects.astro · statisch" data-xray-kind="static">
	{
		projects.map(({ id, data }) => {
			const decision = data.decisions?.[0];
			return (
				<article class="card" data-project-kind={data.kind} data-reveal>
					<a class="shot" href={`/projects/${id}`} tabindex="-1" aria-hidden="true">
						<img
							src={data.cover!.src}
							alt=""
							width={data.cover!.width}
							height={data.cover!.height}
							loading="lazy"
							decoding="async"
						/>
					</a>
					<div class="body">
						<p class="kind">{kindLabels[data.kind]}</p>
						<h3 style={`view-transition-name: project-${id}`}>
							<a href={`/projects/${id}`}>{data.title}</a>
						</h3>
						<p class="summary">{data.summary}</p>
						{decision && (
							<p class="decision">
								{decision.rejected.length > 0 && (
									<>
										<s>{decision.rejected.join(' / ')}</s>
										<span class="sr-only">(verworfen), stattdessen:</span>
										<span aria-hidden="true"> → </span>
									</>
								)}
								<strong>{decision.chosen}</strong>
							</p>
						)}
						<p class="actions">
							{data.liveUrl && (
								<a class="live-link" href={data.liveUrl} target="_blank" rel="noopener noreferrer">
									{data.liveLabel ?? 'Live ansehen'}
									<span class="sr-only"> (öffnet in neuem Tab)</span>
								</a>
							)}
							<a class="read" href={`/projects/${id}`}>
								Projekt lesen<span class="sr-only">: {data.title}</span>
							</a>
						</p>
					</div>
				</article>
			);
		})
	}
</div>

<style>
	.featured {
		display: grid;
		gap: 2rem 1.5rem;
		margin-top: 1.75rem;
	}

	/* The first card leads: wider column, so the three do not read as equals. */
	@media (min-width: 900px) {
		.featured {
			grid-template-columns: 1.35fr 1fr 1fr;
		}
	}

	@media (min-width: 640px) and (max-width: 899px) {
		.featured {
			grid-template-columns: 1fr 1fr;
		}

		.card:first-child {
			grid-column: 1 / -1;
		}
	}

	.card {
		display: grid;
		align-content: start;
		gap: 1rem;
		min-width: 0;
	}

	.shot {
		display: block;
		overflow: hidden;
		border: 1px solid var(--color-border);
		border-radius: 0.5rem;
		background-color: var(--color-surface-raised);
		transition: border-color 0.2s;
	}

	.shot img {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 16 / 10;
		object-fit: cover;
		transition: transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
	}

	.card:hover .shot {
		border-color: var(--color-accent);
	}

	.card:hover .shot img {
		transform: scale(1.02);
	}

	.body {
		display: grid;
		gap: 0.55rem;
	}

	.body p {
		margin: 0;
	}

	.kind {
		font: 12px var(--font-mono);
		color: var(--color-text-muted);
	}

	h3 {
		margin: 0;
		font-size: 1.35rem;
		font-weight: 600;
		line-height: 1.15;
		letter-spacing: -0.02em;
		color: var(--color-text);
	}

	h3 a {
		color: inherit;
		text-decoration: none;
		text-underline-offset: 5px;
		text-decoration-thickness: 2px;
	}

	h3 a:hover {
		color: var(--color-accent);
		text-decoration: underline;
	}

	.summary {
		font-size: 0.925rem;
		line-height: 1.55;
		color: var(--color-text-muted);
	}

	.decision {
		border-left: 2px solid var(--color-accent);
		padding-left: 0.75rem;
		font-size: 0.875rem;
		line-height: 1.5;
		color: var(--color-text-muted);
	}

	.decision strong {
		font-weight: 600;
		color: var(--color-text);
	}

	.body .actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.75rem 1.25rem;
		margin-top: 0.35rem;
	}

	.read {
		font: 500 13.5px var(--font-sans);
		color: var(--color-accent);
		text-decoration: none;
		border-bottom: 1px solid color-mix(in srgb, var(--color-accent) 35%, transparent);
	}

	.read:hover {
		border-bottom-color: var(--color-accent);
	}

	@media (prefers-reduced-motion: reduce) {
		.shot,
		.shot img {
			transition: none;
		}

		.card:hover .shot img {
			transform: none;
		}
	}
</style>
