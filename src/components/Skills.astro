---
import { skillGroups } from '../data/skills';
---

{/* The full stack, grouped by domain. The hero shows only the core chips and links here. */}
<div
	data-reveal
	class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4"
	data-xray="Skills.astro · statisch"
	data-xray-kind="static"
>
	{
		skillGroups.map((group) => (
			<div>
				<h3 class="text-sm font-semibold text-[var(--color-text)]">{group.label}</h3>
				<div class="mt-3 flex flex-wrap gap-1.5">
					{group.skills.map((skill) => (
						<span
							class:list={[
								'rounded border px-2 py-0.5 font-mono text-xs',
								skill.core
									? 'border-[var(--color-accent)] bg-[var(--color-accent-soft)] text-[var(--color-accent)]'
									: 'border-[var(--color-border)] text-[var(--color-text-muted)]',
							]}
						>
							{skill.name}
						</span>
					))}
				</div>
			</div>
		))
	}
</div>
