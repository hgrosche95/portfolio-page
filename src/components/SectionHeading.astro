---
interface Props {
	title: string;
	subtitle?: string;
	/** Appended to the subtitle, but only from the `sm` breakpoint up. */
	desktopHint?: string;
}

const { title, subtitle, desktopHint } = Astro.props;
---

<div data-reveal>
	{/* data-trace-stop + .trace-branch: hangs this heading off the margin trace (see global.css). */}
	<h2
		class="relative flex items-center gap-3 text-2xl font-semibold tracking-tight text-[var(--color-text)] sm:text-3xl"
		data-trace-stop
	>
		<span class="trace-branch" aria-hidden="true"></span>
		<span class="solder-pad" aria-hidden="true"></span>
		{title}
	</h2>
	{
		subtitle && (
			<p class="mt-2 max-w-2xl text-sm leading-relaxed text-[var(--color-text-muted)]">
				{subtitle}
				{desktopHint && <span class="hidden sm:inline"> {desktopHint}</span>}
			</p>
		)
	}
</div>
