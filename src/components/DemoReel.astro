---
import type { CollectionEntry } from 'astro:content';
import { createHash } from 'node:crypto';
import { readFileSync } from 'node:fs';
import { join } from 'node:path';

/**
 * Homepage reel: short screen recordings of the live demos, one at a time,
 * picked by tabs. Deliberately calm: a clip plays once when it is in view and
 * stops on its last frame (usually the result); nothing advances on its own.
 *
 * Without JS every clip is simply a figure with native controls, stacked.
 * The script turns that into tabs and removes the native controls in favour
 * of the pause button and chapter marks.
 *
 * `single` is the project-page variant: one clip, no tabs, no title or links
 * (the page header has them). A phone recording sits beside its caption and
 * a chapter list there instead of on a wide stage.
 */
interface Props {
	projects: CollectionEntry<'projects'>[];
	single?: boolean;
}

const single = Astro.props.single ?? false;

const demos = Astro.props.projects
	.filter((p) => p.data.demo)
	.sort((a, b) => a.data.demo!.order - b.data.demo!.order)
	.map((p) => ({ id: p.id, title: p.data.title, liveUrl: p.data.liveUrl, liveLabel: p.data.liveLabel, ...p.data.demo! }));

/*
 * The videos are cached for a week (staticwebapp.config.json) under a fixed
 * file name, so a re-recorded clip would keep playing the old version for
 * returning visitors. A short content hash in the query string gives every
 * new recording its own URL; unchanged files keep theirs and stay cached.
 */
const versioned = (path: string) =>
	`${path}?v=${createHash('sha256').update(readFileSync(join(process.cwd(), 'public', path))).digest('hex').slice(0, 10)}`;

// Round the total first: rounding only the seconds turns 59.8s into "0:60".
const clock = (s: number) => {
	const total = Math.round(s);
	return `${Math.floor(total / 60)}:${String(total % 60).padStart(2, '0')}`;
};
const device = (d: (typeof demos)[number]) =>
	d.format === 'mobile' ? `Mobil · iPhone ${d.width / 2}×${d.height / 2}` : `Live-Demo · ${d.width}×${d.height}`;
---

<div
	class:list={['reel', { 'is-single': single }]}
	data-demo-reel
	data-xray="DemoReel.astro · <video> + Inline-Skript"
	data-xray-kind="static"
>
	{!single && (
	<div class="tabs" role="tablist" aria-label="Aufnahmen" data-tabs hidden>
		{
			demos.map((d, i) => (
				<button
					type="button"
					role="tab"
					id={`demo-tab-${d.id}`}
					aria-controls={`demo-${d.id}`}
					aria-selected={i === 0 ? 'true' : 'false'}
					tabindex={i === 0 ? 0 : -1}
					data-tab
				>
					<span class="tab-title">{d.label}</span>
					<span class="tab-sub">{d.title} · {clock(d.duration)}</span>
					<span class="tab-progress" aria-hidden="true" />
				</button>
			))
		}
	</div>
	)}

	{
		demos.map((d) => (
			<figure
				class="panel"
				id={`demo-${d.id}`}
				aria-labelledby={single ? undefined : `demo-tab-${d.id}`}
				aria-label={single ? `Aufnahme: ${d.title}` : undefined}
				data-panel
				data-format={d.format}
			>
				<div class="stage">
					<div class="bar">
						<span class="where">
							{d.id}
							<span class="device"> · {device(d)}</span>
						</span>
						<span class="controls">
							<span class="state" data-state aria-hidden="true" />
							<button type="button" class="toggle" data-toggle aria-label="Video abspielen" hidden>
								<svg viewBox="0 0 12 12" width="12" height="12" aria-hidden="true">
									<path class="icon-play" d="M3 1.5v9l7.5-4.5z" />
									<path class="icon-pause" d="M2.5 1.5h2.5v9h-2.5zM7 1.5h2.5v9h-2.5z" />
								</svg>
							</button>
						</span>
					</div>
					<div class="screen">
						<div class="frame">
							<video
								poster={versioned(d.poster)}
								width={d.width}
								height={d.height}
								muted
								playsinline
								preload="none"
								controls
								disablepictureinpicture
								disableremoteplayback
								aria-describedby={`demo-cap-${d.id}`}
								data-video
								data-duration={d.duration}
							>
								{/* H.264 first (hardware decoding, Safari/iOS); VP9 for Chromium builds without H.264. */}
								<source src={versioned(d.src)} type="video/mp4" />
								<source src={versioned(d.src.replace(/\.mp4$/, '.webm'))} type="video/webm" />
							</video>
						</div>
						<div class="end" data-end hidden>
							<button type="button" data-replay>Nochmal abspielen</button>
							<button type="button" data-next hidden />
						</div>
					</div>
				</div>

				<ol class="chapters" aria-label="Kapitel" data-chapters hidden>
					{d.chapters.map((c) => (
						<li style={`--at: ${c.t / d.duration}`}>
							<button type="button" data-seek={c.t} aria-label={`Kapitel ${c.label} (${clock(c.t)})`}>
								<span class="pad" aria-hidden="true" />
								<span class="label">{c.label}</span>
								<span class="time" aria-hidden="true">{clock(c.t)}</span>
							</button>
						</li>
					))}
				</ol>

				<figcaption id={`demo-cap-${d.id}`}>
					{!single && (
						<h3>
							<a href={`/projects/${d.id}`}>{d.title}</a>
						</h3>
					)}
					<p class="caption">{d.caption}</p>
					<p class="meta">Echter Lauf auf der Live-Demo, beschleunigt und ohne Ton, {clock(d.duration)}</p>
					{!single && (
					<p class="links">
						<a href={`/projects/${d.id}`}>Projekt lesen</a>
						{d.liveUrl && (
							<a href={d.liveUrl} target="_blank" rel="noopener noreferrer">
								{d.liveLabel ?? 'Live ansehen'}
								<span class="sr-only"> (öffnet in neuem Tab)</span>
							</a>
						)}
					</p>
					)}
				</figcaption>
			</figure>
		))
	}
</div>

<script is:inline>
	(() => {
		const reel = document.querySelector('[data-demo-reel]');
		if (!reel || reel.dataset.ready) return;
		reel.dataset.ready = 'true';

		const tabs = [...reel.querySelectorAll('[data-tab]')];
		const panels = [...reel.querySelectorAll('[data-panel]')];
		const videos = panels.map((p) => p.querySelector('[data-video]'));
		const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
		const saveData = Boolean(navigator.connection && navigator.connection.saveData);
		// Autoplay only where nobody asked for less motion or less data.
		const mayAutoplay = !reduceMotion && !saveData;

		let active = 0;
		// On a phone a desktop recording shrinks to an unreadable strip, so the
		// reel opens on the first phone recording there instead.
		if (tabs.length && matchMedia('(max-width: 639px)').matches) {
			const phone = panels.findIndex((p) => p.dataset.format === 'mobile');
			if (phone > 0) {
				active = phone;
				tabs.forEach((t, k) => {
					t.setAttribute('aria-selected', String(k === phone));
					t.tabIndex = k === phone ? 0 : -1;
				});
			}
		}
		let inView = false;
		// Set once the visitor pauses by hand: scrolling back must not override that.
		let userPaused = false;

		// Chapter labels that would run into each other drop to a second row;
		// labels that would stick out of the trace are pulled back inside.
		const layoutLabels = (list) => {
			// The vertical chapter list (phone clip on a project page) needs no layout pass.
			if (getComputedStyle(list).display === 'flex') {
				list.classList.remove('two-rows');
				list.querySelectorAll('.label').forEach((l) => (l.style.translate = ''));
				return;
			}
			const labels = [...list.querySelectorAll('.label')];
			labels.forEach((l) => (l.style.translate = ''));
			const box = list.getBoundingClientRect();
			const rowEnds = [-Infinity, -Infinity];
			let twoRows = false;
			for (const label of labels) {
				const r = label.getBoundingClientRect();
				if (r.width <= 1) continue; // hidden (small screens show only the current label)
				let shift = 0;
				if (r.right > box.right) shift = box.right - r.right;
				if (r.left + shift < box.left) shift = box.left - r.left;
				const row = r.left + shift >= rowEnds[0] + 8 ? 0 : 1;
				rowEnds[row] = r.right + shift;
				if (row) twoRows = true;
				if (shift || row) label.style.translate = `${shift}px ${row ? '1.1rem' : '0'}`;
			}
			list.classList.toggle('two-rows', twoRows);
		};
		const labelObserver = 'ResizeObserver' in window ? new ResizeObserver((entries) => entries.forEach((e) => layoutLabels(e.target))) : null;

		reel.dataset.enhanced = 'true';
		const tablist = reel.querySelector('[data-tabs]');
		if (tablist) tablist.hidden = false;

		panels.forEach((panel, i) => {
			const video = videos[i];
			const toggle = panel.querySelector('[data-toggle]');
			const end = panel.querySelector('[data-end]');
			const next = panel.querySelector('[data-next]');
			const chapters = panel.querySelector('[data-chapters]');
			const seeks = [...panel.querySelectorAll('[data-seek]')];

			if (tabs.length) panel.setAttribute('role', 'tabpanel');
			panel.hidden = i !== active;
			video.controls = false;
			toggle.hidden = false;
			chapters.hidden = false;
			labelObserver?.observe(chapters);
			let shownChapter = -1;

			if (panels.length > 1) {
				const target = (i + 1) % panels.length;
				next.textContent = `Weiter: ${tabs[target].querySelector('.tab-title').textContent} →`;
				next.hidden = false;
				next.addEventListener('click', () => activate(target, true));
			}

			const sync = () => {
				const playing = !video.paused && !video.ended;
				panel.dataset.playing = String(playing);
				toggle.setAttribute('aria-label', playing ? 'Video pausieren' : 'Video abspielen');
				panel.querySelector('[data-state]').textContent = video.ended ? 'Ende' : playing ? 'läuft' : 'pausiert';
			};

			const progress = () => {
				const duration = video.duration || Number(video.dataset.duration);
				const p = Math.min(1, video.currentTime / duration);
				panel.style.setProperty('--p', p);
				tabs[i]?.style.setProperty('--p', p);
				let current = 0;
				seeks.forEach((s, k) => {
					if (video.currentTime >= Number(s.dataset.seek) - 0.05) current = k;
				});
				seeks.forEach((s, k) => s.toggleAttribute('data-current', k === current));
				if (current !== shownChapter) {
					shownChapter = current;
					layoutLabels(chapters);
				}
			};

			video.addEventListener('play', () => {
				end.hidden = true;
				sync();
			});
			video.addEventListener('pause', sync);
			video.addEventListener('ended', () => {
				end.hidden = false;
				sync();
			});
			video.addEventListener('timeupdate', progress);
			video.addEventListener('seeked', progress);

			const playOrPause = () => {
				if (video.paused || video.ended) {
					userPaused = false;
					start(i);
				} else {
					userPaused = true;
					video.pause();
				}
			};
			toggle.addEventListener('click', playOrPause);
			video.addEventListener('click', playOrPause);

			end.querySelector('[data-replay]').addEventListener('click', () => {
				video.currentTime = 0;
				userPaused = false;
				start(i);
			});

			seeks.forEach((s) =>
				s.addEventListener('click', () => {
					video.currentTime = Number(s.dataset.seek);
					userPaused = false;
					start(i);
				}),
			);

			sync();
		});

		function start(i) {
			const attempt = videos[i].play();
			// Autoplay blocked or data unavailable: stay on the poster with the play button.
			if (attempt) attempt.catch(() => {});
		}

		function activate(i, byUser) {
			if (i === active && !byUser) return;
			videos[active].pause();
			tabs.forEach((t, k) => {
				t.setAttribute('aria-selected', String(k === i));
				t.tabIndex = k === i ? 0 : -1;
			});
			panels.forEach((p, k) => (p.hidden = k !== i));
			active = i;
			if (byUser) {
				userPaused = false;
				if (videos[i].ended) videos[i].currentTime = 0;
				start(i);
			} else if (mayAutoplay && inView && !userPaused) {
				start(i);
			}
		}

		tabs.forEach((tab, i) => {
			tab.addEventListener('click', () => activate(i, true));
			tab.addEventListener('keydown', (e) => {
				const last = tabs.length - 1;
				const to = { ArrowRight: i + 1, ArrowDown: i + 1, ArrowLeft: i - 1, ArrowUp: i - 1, Home: 0, End: last }[e.key];
				if (to === undefined) return;
				e.preventDefault();
				const target = (to + tabs.length) % tabs.length;
				tabs[target].focus();
				activate(target, true);
			});
		});

		if ('IntersectionObserver' in window) {
			new IntersectionObserver(
				(entries) => {
					// Half the reel in view, or (reel taller than the screen) half the screen filled by it.
					const e = entries[entries.length - 1];
					const was = inView;
					inView = e.isIntersecting && (e.intersectionRatio >= 0.5 || e.intersectionRect.height >= innerHeight * 0.5);
					if (inView === was) return;
					// Act only on the change: a clip started by hand keeps playing while half visible.
					const video = videos[active];
					if (!inView) video.pause();
					else if (mayAutoplay && !userPaused && video.paused && !video.ended) start(active);
				},
				{ threshold: [0, 0.25, 0.5, 0.75] },
			).observe(reel);
		}

		// Web fonts change label widths after the first layout.
		document.fonts?.ready.then(() => panels.forEach((p) => layoutLabels(p.querySelector('[data-chapters]'))));

		document.addEventListener('visibilitychange', () => {
			if (document.hidden) videos[active].pause();
			else if (mayAutoplay && inView && !userPaused && !videos[active].ended) start(active);
		});
	})();
</script>

<style>
	.reel {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: 2rem;
		margin-top: 1.5rem;
	}

	.reel[data-enhanced] {
		gap: 1rem;
	}

	/* Tabs: a row of three above the stage, at every width. */
	.tabs {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 0.4rem;
	}

	.tabs[hidden] {
		display: none;
	}

	[role='tab'] {
		display: grid;
		gap: 0.15rem;
		min-width: 0;
		padding: 0.55rem 0.7rem 0;
		border: 1px solid var(--color-border);
		border-radius: 0.5rem;
		background-color: var(--color-surface);
		color: var(--color-text-muted);
		text-align: left;
		cursor: pointer;
		overflow: hidden;
		transition:
			border-color 0.2s,
			color 0.2s;
	}

	[role='tab']:hover {
		border-color: var(--color-border-strong);
		color: var(--color-text);
	}

	[role='tab'][aria-selected='true'] {
		border-color: var(--color-accent);
		background-color: var(--color-accent-soft);
		color: var(--color-text);
	}

	.tab-title {
		overflow: hidden;
		font: 600 13px var(--font-mono);
		white-space: nowrap;
		text-overflow: ellipsis;
	}

	[aria-selected='true'] .tab-title {
		color: var(--color-accent);
	}

	.tab-sub {
		display: none;
		overflow: hidden;
		font-size: 12.5px;
		white-space: nowrap;
		text-overflow: ellipsis;
	}

	.tab-progress {
		display: block;
		height: 2px;
		margin: 0.45rem -0.7rem 0;
		background: linear-gradient(to right, var(--color-accent) calc(var(--p, 0) * 100%), transparent 0);
	}

	[aria-selected='false'] .tab-progress {
		opacity: 0.45;
	}

	/* Stage: same frame language as the agent console in the hero. */
	.stage {
		overflow: hidden;
		border: 1px solid var(--color-border-strong);
		border-radius: 0.75rem;
		background-color: var(--color-surface);
	}

	.bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		border-bottom: 1px dashed var(--color-border-strong);
		padding: 0.45rem 0.6rem 0.45rem 0.875rem;
		font: 12px var(--font-mono);
		color: var(--color-text-muted);
	}

	.where {
		min-width: 0;
		overflow: hidden;
		white-space: nowrap;
		text-overflow: ellipsis;
	}

	.controls {
		display: flex;
		flex: none;
		align-items: center;
		gap: 0.6rem;
	}

	.state {
		color: var(--color-text-muted);
	}

	[data-playing='true'] .state {
		color: var(--color-live);
	}

	.toggle {
		display: grid;
		place-items: center;
		width: 1.75rem;
		height: 1.75rem;
		border: 1px solid var(--color-border-strong);
		border-radius: 0.375rem;
		background: none;
		color: var(--color-text);
		cursor: pointer;
	}

	.toggle:hover {
		border-color: var(--color-accent);
		color: var(--color-accent);
	}

	.toggle[hidden] {
		display: none;
	}

	.toggle path {
		fill: currentColor;
	}

	.icon-pause,
	[data-playing='true'] .icon-play {
		display: none;
	}

	[data-playing='true'] .icon-pause {
		display: inline;
	}

	.screen {
		position: relative;
		display: grid;
		place-items: center;
		padding: 0.75rem;
		background-color: var(--color-surface-raised);
	}

	.frame {
		width: 100%;
		overflow: hidden;
		border: 1px solid var(--color-border);
		border-radius: 0.4rem;
		background-color: var(--color-bg);
	}

	video {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 16 / 10;
	}

	[data-format='mobile'] .frame {
		width: auto;
		max-width: 100%;
		border: 6px solid var(--color-surface);
		border-radius: 1.75rem;
		outline: 1px solid var(--color-border-strong);
	}

	[data-format='mobile'] video {
		width: auto;
		height: min(70svh, 34rem);
		max-width: 100%;
		aspect-ratio: 390 / 664;
		object-fit: cover;
	}

	/*
	 * With the script, every clip shares one stage size so switching tabs
	 * never moves the page: square on small screens (tall enough for the
	 * phone clip), 16:10 and full width on wide ones. Inside it the
	 * phone frame is sized by height, a desktop clip by width.
	 */
	[data-enhanced] .screen {
		aspect-ratio: 1 / 1;
		max-height: min(72svh, 36rem);
		width: 100%;
	}

	[data-enhanced] [data-format='mobile'] .frame {
		height: 100%;
		aspect-ratio: 390 / 664;
	}

	[data-enhanced] [data-format='mobile'] video {
		width: 100%;
		height: 100%;
	}

	[data-enhanced] video {
		cursor: pointer;
	}

	.end {
		position: absolute;
		inset: auto 0 1.25rem;
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.5rem;
		padding: 0 1rem;
	}

	.end[hidden] {
		display: none;
	}

	.end button {
		padding: 0.45rem 0.8rem;
		border: 1px solid var(--color-border-strong);
		border-radius: 0.5rem;
		background-color: var(--color-surface);
		box-shadow: 0 2px 10px rgb(0 0 0 / 0.18);
		font: 12.5px var(--font-mono);
		color: var(--color-text);
		cursor: pointer;
	}

	.end button:hover {
		border-color: var(--color-accent);
		color: var(--color-accent);
	}

	.end button[hidden] {
		display: none;
	}

	/* Chapter marks on a trace, like the one along the page margin. */
	.chapters {
		position: relative;
		height: 2.4rem;
		margin: 0.9rem 0.4rem 0;
		padding: 0;
		list-style: none;
	}

	.chapters[hidden] {
		display: none;
	}

	.chapters::before {
		content: '';
		position: absolute;
		inset: 0.35rem 0 auto;
		height: 2px;
		background: linear-gradient(to right, var(--color-accent) calc(var(--p, 0) * 100%), var(--color-border) 0);
	}

	.chapters li {
		position: absolute;
		top: 0;
		left: calc(var(--at) * 100%);
		translate: -0.4rem 0;
	}

	.chapters.two-rows {
		height: 3.5rem;
	}

	.chapters button {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.3rem;
		padding: 0;
		border: 0;
		background: none;
		color: var(--color-text-muted);
		cursor: pointer;
	}

	.pad {
		width: 0.8rem;
		height: 0.8rem;
		border: 2px solid var(--color-border-strong);
		border-radius: 50%;
		background-color: var(--color-bg);
		transition:
			border-color 0.2s,
			background-color 0.2s;
	}

	.chapters button:hover .pad,
	[data-current] .pad {
		border-color: var(--color-accent);
	}

	[data-current] .pad {
		background-color: var(--color-accent);
	}

	.label {
		font: 11px var(--font-mono);
		white-space: nowrap;
	}

	[data-current] .label,
	.chapters button:hover .label {
		color: var(--color-text);
	}

	figure {
		margin: 0;
	}

	figcaption {
		margin-top: 0.75rem;
	}

	h3 {
		margin: 0;
		font-size: 1.05rem;
		font-weight: 600;
	}

	h3 a {
		color: var(--color-text);
		text-decoration: none;
	}

	h3 a:hover {
		color: var(--color-accent);
	}

	.caption {
		max-width: 44rem;
		margin: 0.3rem 0 0;
		font-size: 0.9rem;
		line-height: 1.6;
		color: var(--color-text-muted);
	}

	.meta {
		margin: 0.5rem 0 0;
		font: 12px var(--font-mono);
		color: var(--color-text-muted);
	}

