---
import { kindLabels, type ProjectKind } from '../lib/project-kinds';

interface Props {
	/** Kinds that actually occur, most common first, with their project counts. */
	kinds: { kind: ProjectKind; count: number }[];
	total: number;
}

const { kinds, total } = Astro.props;

const baseChipClass =
	'rounded border px-2.5 py-1.5 text-sm transition-colors hover:border-[var(--color-accent)] hover:text-[var(--color-accent)]';
const inactiveChipClass = 'border-[var(--color-border)] text-[var(--color-text-muted)]';
const activeChipClass = 'border-[var(--color-accent)] bg-[var(--color-accent-soft)] text-[var(--color-accent)]';
---

{/*
	Filters by what a project is, not by every library it touches: a handful of
	kinds is a real choice, seventeen technology chips for seven projects was not.
	One kind at a time, since the kinds don't overlap.
*/}
<div
	data-reveal
	class="mt-6 flex flex-wrap items-center gap-2"
	data-xray="ProjectFilter.astro · Inline-Skript, kein Bundle"
	data-xray-kind="static"
>
	<div id="project-filter" role="group" aria-label="Projekte nach Art filtern" class="flex flex-wrap gap-1.5">
		<button type="button" data-filter-kind="" class={`${baseChipClass} ${activeChipClass}`} aria-pressed="true">
			Alle <span class="font-mono text-xs tabular-nums">{total}</span>
		</button>
		{
			kinds.map(({ kind, count }) => (
				<button
					type="button"
					data-filter-kind={kind}
					class={`${baseChipClass} ${inactiveChipClass}`}
					aria-pressed="false"
				>
					{kindLabels[kind]} <span class="font-mono text-xs tabular-nums">{count}</span>
				</button>
			))
		}
	</div>
	<span id="project-filter-count" role="status" class="ml-1 text-sm text-[var(--color-text-muted)]"></span>
</div>

<script>
	(function () {
		const root = document.getElementById('project-filter');
		const buttons = root ? Array.from(root.querySelectorAll<HTMLButtonElement>('[data-filter-kind]')) : [];
		const countEl = document.getElementById('project-filter-count');
		if (!root || buttons.length < 2) return;

		const INACTIVE = ['border-[var(--color-border)]', 'text-[var(--color-text-muted)]'];
		const ACTIVE = ['border-[var(--color-accent)]', 'bg-[var(--color-accent-soft)]', 'text-[var(--color-accent)]'];

		// Every project row on the page declares its
		// own kind; nothing here needs to know how many exist or where they live.
		function apply(selected: string) {
			const all = Array.from(document.querySelectorAll<HTMLElement>('[data-project-kind]'));
			let visible = 0;
			for (const project of all) {
				const matches = selected === '' || project.dataset.projectKind === selected;
				project.hidden = !matches;
				if (matches) visible += 1;
			}
			for (const button of buttons) {
				const pressed = button.dataset.filterKind === selected;
				button.setAttribute('aria-pressed', String(pressed));
				INACTIVE.forEach((cls) => button.classList.toggle(cls, !pressed));
				ACTIVE.forEach((cls) => button.classList.toggle(cls, pressed));
			}
			if (countEl) countEl.textContent = selected === '' ? '' : `${visible} von ${all.length} Projekten`;
		}

		buttons.forEach((button) => button.addEventListener('click', () => apply(button.dataset.filterKind ?? '')));
	})();
</script>
