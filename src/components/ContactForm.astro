---
/**
 * Posts to the Azure Function in /api. Written as plain HTML plus a small
 * inline script rather than a React island, so the page keeps shipping no
 * JavaScript bundle. The mailto card below the form stays as the fallback for
 * anyone without JavaScript.
 */
const fieldClass =
	'mt-1.5 w-full rounded-md border border-[var(--color-border)] bg-[var(--color-surface)] px-3 py-2 font-mono text-sm text-[var(--color-text)] transition-colors placeholder:text-[var(--color-text-muted)] focus:border-[var(--color-accent)] focus:outline-none';
const labelClass = 'font-mono text-xs tracking-wider text-[var(--color-text-muted)] uppercase';
const errorClass = 'mt-1 hidden font-mono text-xs text-[var(--color-accent)]';
---

<form
	id="contact-form"
	novalidate
	data-reveal
	data-xray="ContactForm.astro · Inline-Skript, kein Bundle"
	data-xray-kind="static"
	class="mt-6 rounded-lg border border-[var(--color-border)] bg-[var(--color-surface)] p-5"
>
	<div class="grid gap-4 sm:grid-cols-2">
		<div>
			<label class={labelClass} for="contact-name">Name</label>
			<input
				id="contact-name"
				name="name"
				type="text"
				required
				maxlength="80"
				autocomplete="name"
				class={fieldClass}
				placeholder="Vor- und Nachname"
			/>
			<p class={errorClass} data-error-for="name"></p>
		</div>
		<div>
			<label class={labelClass} for="contact-email">E-Mail</label>
			<input
				id="contact-email"
				name="email"
				type="email"
				required
				maxlength="120"
				autocomplete="email"
				class={fieldClass}
				placeholder="name@firma.de"
			/>
			<p class={errorClass} data-error-for="email"></p>
		</div>
	</div>

	<div class="mt-4">
		<label class={labelClass} for="contact-message">Nachricht</label>
		<textarea
			id="contact-message"
			name="message"
			required
			rows="5"
			maxlength="4000"
			class={fieldClass}
			placeholder="Worum geht es?"></textarea>
		<p class={errorClass} data-error-for="message"></p>
	</div>

	{/* Honeypot: hidden from people, irresistible to bots. */}
	<div class="absolute left-[-9999px] h-0 w-0 overflow-hidden" aria-hidden="true">
		<label for="contact-company">Firma (bitte frei lassen)</label>
		<input id="contact-company" name="company" type="text" tabindex="-1" autocomplete="off" />
	</div>

	<div class="mt-5 flex flex-wrap items-center gap-4">
		<button
			id="contact-submit"
			type="submit"
			class="rounded-md bg-[var(--color-accent)] px-4 py-2 font-mono text-sm font-medium text-[var(--color-bg)] transition-opacity hover:opacity-85 disabled:cursor-not-allowed disabled:opacity-50"
		>
			Nachricht senden
		</button>
		<p
			id="contact-status"
			role="status"
			aria-live="polite"
			class="font-mono text-xs text-[var(--color-text-muted)]"
		>
		</p>
	</div>
</form>

<script is:inline>
	(function () {
		const form = document.getElementById('contact-form');
		if (!form) return;

		const button = document.getElementById('contact-submit');
		const status = document.getElementById('contact-status');
		const errors = form.querySelectorAll('[data-error-for]');

		function clearErrors() {
			errors.forEach(function (el) {
				el.textContent = '';
				el.classList.add('hidden');
			});
		}

		function showErrors(fieldErrors) {
			Object.keys(fieldErrors).forEach(function (field) {
				const el = form.querySelector('[data-error-for="' + field + '"]');
				if (!el) return;
				el.textContent = fieldErrors[field];
				el.classList.remove('hidden');
			});
		}

		// Mirrors the rules in api/src/functions/contact.ts so an obvious mistake
		// is caught without a round trip. The server stays authoritative — this
		// is convenience, not the actual check.
		function validate(data) {
			const problems = {};
			const name = (data.name || '').trim();
			const email = (data.email || '').trim();
			const message = (data.message || '').trim();

			if (!name) problems.name = 'Bitte gib deinen Namen an.';
			if (!email) problems.email = 'Bitte gib deine E-Mail-Adresse an.';
			else if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email))
				problems.email = 'Diese E-Mail-Adresse sieht nicht gültig aus.';
			if (!message) problems.message = 'Bitte schreib eine Nachricht.';
			else if (message.length < 10) problems.message = 'Mindestens 10 Zeichen.';

			return problems;
		}

		form.addEventListener('submit', async function (event) {
			event.preventDefault();
			clearErrors();

			const data = Object.fromEntries(new FormData(form).entries());

			const problems = validate(data);
			if (Object.keys(problems).length > 0) {
				showErrors(problems);
				status.textContent = 'Bitte prüf die markierten Felder.';
				const firstField = form.querySelector('[name="' + Object.keys(problems)[0] + '"]');
				if (firstField) firstField.focus();
				return;
			}

			button.disabled = true;
			status.textContent = 'Wird gesendet…';

			try {
				const response = await fetch('/api/contact', {
					method: 'POST',
					headers: { 'content-type': 'application/json' },
					body: JSON.stringify(data),
				});
				const result = await response.json().catch(function () {
					return {};
				});

				if (response.ok) {
					form.reset();
					status.textContent = 'Danke — die Nachricht ist angekommen.';
					return;
				}

				if (result.errors) {
					showErrors(result.errors);
					status.textContent = 'Bitte prüf die markierten Felder.';
					return;
				}

				status.textContent = result.error || 'Das hat nicht geklappt. Versuch es später noch einmal.';
			} catch {
				status.textContent = 'Keine Verbindung. Schreib mir gern direkt per E-Mail.';
			} finally {
				button.disabled = false;
			}
		});
	})();
</script>
